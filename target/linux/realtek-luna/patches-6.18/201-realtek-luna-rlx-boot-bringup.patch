--- a/arch/mips/mm/c-r4k.c
+++ b/arch/mips/mm/c-r4k.c
@@ -1174,6 +1174,48 @@
 		c->options |= MIPS_CPU_PREFETCH;
 		break;
 
+	case CPU_RLX_TAROKO:
+		/*
+		 * The RLX leaves Config0.M clear (so the generic MIPS32 path
+		 * below refuses to probe), but it does implement the Config1
+		 * cache-descriptor fields.  Decode them the same way; dump the
+		 * raw words once so the geometry can be cross-checked against
+		 * stock (which reports 64kB/32B I-cache, 32kB/32B D-cache, no
+		 * L2).  Fall back to that stock geometry if Config1 reads bogus.
+		 */
+		config1 = read_c0_config1();
+		pr_info("RLX cache probe: Config0=%08x Config1=%08lx\n",
+			config, config1);
+		lsize = (config1 >> 19) & 7;
+		c->icache.linesz = lsize ? 2 << lsize : 0;
+		c->icache.sets = 32 << (((config1 >> 22) + 1) & 7);
+		c->icache.ways = 1 + ((config1 >> 16) & 7);
+		icache_size = c->icache.sets * c->icache.ways * c->icache.linesz;
+		lsize = (config1 >> 10) & 7;
+		c->dcache.linesz = lsize ? 2 << lsize : 0;
+		c->dcache.sets = 32 << (((config1 >> 13) + 1) & 7);
+		c->dcache.ways = 1 + ((config1 >> 7) & 7);
+		dcache_size = c->dcache.sets * c->dcache.ways * c->dcache.linesz;
+		if (icache_size != 0x10000 || dcache_size != 0x8000) {
+			pr_info("RLX: Config1 cache fields bogus (ic=%lu dc=%lu) -> stock geometry\n",
+				icache_size, dcache_size);
+			c->icache.linesz = 32; c->icache.ways = 4; c->icache.sets = 512;
+			icache_size = 0x10000;
+			c->dcache.linesz = 32; c->dcache.ways = 4; c->dcache.sets = 256;
+			dcache_size = 0x8000;
+		}
+		c->icache.waybit = __ffs(icache_size / c->icache.ways);
+		c->dcache.waybit = __ffs(dcache_size / c->dcache.ways);
+		/*
+		 * Do NOT set MIPS_CPU_PREFETCH: the RLX ALU is MIPS II-class and
+		 * lacks `pref`; the runtime-built clear_page/copy_page would emit
+		 * `pref 30` and fault.  Leave prefetch off.
+		 */
+		pr_info("RLX cache: icache %luK/%dB/%dway dcache %luK/%dB/%dway\n",
+			icache_size >> 10, c->icache.linesz, c->icache.ways,
+			dcache_size >> 10, c->dcache.linesz, c->dcache.ways);
+		break;
+
 	default:
 		if (!(config & MIPS_CONF_M))
 			panic("Don't know how to probe P-caches on this cpu.");
