{
	"luci-app-xpon": {
		"description": "Grant access to the PON pages: PON mode, GPON (OMCI) and EPON (OAM)",
		"read": {
			"uci": [
				"xpon",
				"omci",
				"network",
				"epon"
			],
			"ubus": {
				"xpon": [
					"family",
					"status",
					"config_list",
					"config_details",
					"config_get",
					"config_inspect",
					"class_list",
					"class_get",
					"mib_list",
					"mib_get",
					"status_live",
					"events",
					"vlan_status",
					"summary"
				]
			},
			"file": {
				"/var/run/epon-oamd.json": [
					"read"
				],
				"/tmp/run/epon-oamd.json": [
					"read"
				],
				"/etc/xpon-rogue": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"uci": [
					"commit"
				],
				"system": [
					"reboot"
				],
				"file": [
					"remove",
					"stat"
				],
				"xpon": [
					"agent_set",
					"config_set",
					"mib_set",
					"mib_delete",
					"mib_reset",
					"apply",
					"tx_release"
				]
			},
			"uci": [
				"xpon",
				"omci",
				"network",
				"epon"
			],
			"file": {
				"/usr/sbin/xpon-report -o -": [
					"exec"
				],
				"/usr/sbin/xpon-report -u -o -": [
					"exec"
				],
				"/usr/sbin/xpon-mode-switch gpon": [
					"exec"
				],
				"/usr/sbin/xpon-mode-switch epon": [
					"exec"
				],
				"/usr/sbin/omci-vlanscan *": [
					"exec"
				],
				"/etc/xpon-rogue": [
					"write"
				]
			}
		}
	}
}
