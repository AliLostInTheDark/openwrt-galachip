#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# OMCI voice provisioning for uvoice: runs where both are installed.

START=96
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/uvoiced ] || return 0
	[ "$(uci -q get omci.main.pots_count)" -gt 0 ] 2>/dev/null || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/omci-voice
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger omci
}
