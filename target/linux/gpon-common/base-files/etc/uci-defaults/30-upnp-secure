#!/bin/sh
# UPnP IGD (miniupnpd), ON but constrained.
#
# WHY IT SHIPS AT ALL: a home gateway is expected to let an application open its
# own inbound port -- games, consoles, conferencing -- and without it those apps
# fall back to relays or simply do not work.  The vendor firmware ships it; the
# suite already has four cases for it (upnp_igd_present, _port_forward,
# _client_pivot, _wan_exposure) that could only report ABSENT while we shipped
# nothing.
#
# WHY IT IS CONSTRAINED, and what each line actually stops:
#
#   secure_mode=1  -- a client may create a mapping ONLY to ITS OWN address.
#       Without it any device on the LAN can ask the router to forward a port to
#       a DIFFERENT host: a compromised IoT gadget can publish the NAS, or a web
#       page can aim a port at another machine.  This is the single most
#       important UPnP setting and it is off in many vendor images.
#
#   the perm rules  -- high ports only.  `deny 0-65535` is the LAST rule, so
#       anything not explicitly allowed above it is refused; a client cannot map
#       a privileged port (22/23/53/80/443...) on any host.  Order matters:
#       miniupnpd takes the FIRST matching rule.
#
#   external/internal iface -- the control point listens on the LAN side only,
#       and mappings are created on the WAN side.  It is never reachable from
#       the internet, which is what upnp_igd_wan_exposure verifies.
#
# NOT A REPLACEMENT FOR THE FIREWALL: this only governs what a LAN client may
# ask for.  Unsolicited inbound is still refused by firewall4's wan zone.
#
# ★ THERE IS DELIBERATELY NO `uuid` LINE -- DO NOT RE-ADD ONE.
# This file used to carry `set upnpd.config.uuid='<UUID>'`, a literal placeholder
# that nothing in the tree ever substituted.  It is not inert: miniupnpd.init
# regenerates the UUID only when the option is EMPTY
#   [ -z "$uuid" ] && uuid="$(cat /proc/sys/kernel/random/uuid)"
# and the seven-character string `<UUID>` is not empty, so the test never fires.
# The daemon would then advertise `uuid=<UUID>` in its USN on every unit built
# from this image: a malformed UUID, and identical fleet-wide, so two ONUs are
# one device to any control point that keys on it.  Leaving the option UNSET is
# what makes the init script mint a random per-unit UUID on first start and
# persist it with `uci set` + `uci commit` -- correct and self-maintaining.
# ★ DELETE EVERY perm_rule, NOT A COUNTED THREE.
# This used to issue exactly three `delete upnpd.@perm_rule[-1]` -- a hardcoded
# count of what the miniupnpd PACKAGE happens to ship. Measured 2026-08-13: it
# ships TWO, so the third delete was a silent no-op and the result was right by
# luck. The failure mode if that package ever ships more is not cosmetic: our
# rules are ADDED AT THE END, so any survivor sits AHEAD of them, and miniupnpd
# takes the FIRST matching rule -- a leftover `allow` would silently outrank the
# `deny` this file exists to enforce, with nothing to see in the config.
# A count is not a structure; loop until there are none left.
[ -x /usr/sbin/miniupnpd ] || exit 0
while uci -q delete upnpd.@perm_rule[-1]; do :; done

uci -q batch <<-EOF
	delete upnpd.config
	set upnpd.config=upnpd
	set upnpd.config.enabled='1'
	set upnpd.config.enable_natpmp='1'
	set upnpd.config.enable_upnp='1'
	set upnpd.config.secure_mode='1'
	set upnpd.config.log_output='0'
	set upnpd.config.download='1024'
	set upnpd.config.upload='512'
	set upnpd.config.external_iface='wan'
	set upnpd.config.internal_iface='lan'
	set upnpd.config.port='5000'
	set upnpd.config.upnp_lease_file='/var/run/miniupnpd.leases'
	add upnpd perm_rule
	set upnpd.@perm_rule[-1].action='allow'
	set upnpd.@perm_rule[-1].ext_ports='1024-65535'
	set upnpd.@perm_rule[-1].int_addr='0.0.0.0/0'
	set upnpd.@perm_rule[-1].int_ports='1024-65535'
	set upnpd.@perm_rule[-1].comment='Allow high ports'
	add upnpd perm_rule
	set upnpd.@perm_rule[-1].action='deny'
	set upnpd.@perm_rule[-1].ext_ports='0-65535'
	set upnpd.@perm_rule[-1].int_addr='0.0.0.0/0'
	set upnpd.@perm_rule[-1].int_ports='0-65535'
	set upnpd.@perm_rule[-1].comment='Default deny'
	commit upnpd
EOF
exit 0
