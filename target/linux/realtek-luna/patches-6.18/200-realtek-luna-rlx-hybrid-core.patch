@@ -241,6 +241,19 @@ static inline uint64_t pte_to_entrylo(un
 
 #define _CACHE_CACHABLE_NONCOHERENT 0
 #define _CACHE_UNCACHED_ACCELERATED _CACHE_UNCACHED
+/*
+ * The R3000-style TLB has no multi-bit cache-coherency field in EntryLo, only
+ * the single "uncached" bit defined above, so there is no _CACHE_SHIFT here.
+ * The R4000 cache-attribute variants all collapse to plain cacheable (0);
+ * define them so the generic _CACHE_SHIFT-based fallbacks below are skipped.
+ * (Needed by the RLX hybrid, which pairs this TLB layout with the r4k cache
+ * code that references these names.)
+ */
+#define _CACHE_CACHABLE_NO_WA	0
+#define _CACHE_CACHABLE_WA	0
+#define _CACHE_CACHABLE_CE	0
+#define _CACHE_CACHABLE_COW	0
+#define _CACHE_CACHABLE_CUW	0
 
