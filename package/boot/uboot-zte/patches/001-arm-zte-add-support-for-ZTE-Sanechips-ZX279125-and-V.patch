new file mode 100644
index 00000000..4e68e1df
--- /dev/null
+++ b/arch/arm/dts/zx279125-vsol-v2801sg.dts
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Device Tree for VSOL V2801SG (ZTE Sanechips ZX279125)
+ *
+ * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "VSOL V2801SG";
+	compatible = "vsol,v2801sg", "zte,zx279125";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+		spi0 = &spifc;
+		ethernet0 = &ethernet;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <0>;
+		};
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x01000000>; /* 16 MiB DDR3 DRAM (below PPE pool) */
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		timer0: timer@94401000 {
+			compatible = "zte,zx279125-timer";
+			reg = <0x94401000 0x100>;
+			clock-frequency = <12500000>;
+			bootph-all;
+			u-boot,dm-pre-reloc;
+		};
+
+		uart0: serial@94405000 {
+			compatible = "zte,zx279125-uart";
+			reg = <0x94405000 0x100>;
+			clock-frequency = <25000000>;
+			current-speed = <115200>;
+			bootph-all;
+			u-boot,dm-pre-reloc;
+		};
+
+		spifc: spi@94407000 {
+			compatible = "zte,zx279125-spifc";
+			reg = <0x94407000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <25000000>;
+
+				partitions {
+					compatible = "fixed-partitions";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					partition@0 {
+						label = "u-boot";
+						reg = <0x000000 0x040000>;
+						read-only;
+					};
+
+					partition@40000 {
+						label = "firmware";
+						reg = <0x040000 0x740000>;
+					};
+
+					partition@780000 {
+						label = "others";
+						reg = <0x780000 0x010000>;
+					};
+
+					partition@790000 {
+						label = "tagparam";
+						reg = <0x790000 0x010000>;
+					};
+
+					partition@7a0000 {
+						label = "usercfg";
+						reg = <0x7a0000 0x060000>;
+					};
+				};
+			};
+		};
+
+		ethernet: ethernet@92144000 {
+			compatible = "zte,zx279125-eth";
+			reg = <0x92144000 0x1000>;
+			status = "okay";
+		};
+	};
+};
