From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] spl: allow the TPL to load legacy images

spl_legacy.o is built for CONFIG_$(PHASE_)LEGACY_IMAGE_FORMAT, but there is
no TPL_LEGACY_IMAGE_FORMAT, so a TPL always gets the weak
spl_parse_legacy_header() that rejects every legacy image. Add the option.

diff --git a/common/spl/Kconfig.tpl b/common/spl/Kconfig.tpl
index 5fad3e57..23050ab4 100644
--- a/common/spl/Kconfig.tpl
+++ b/common/spl/Kconfig.tpl
@@ -225,6 +225,13 @@ config TPL_I2C
 	  Enable support for the I2C bus in TPL. See SPL_I2C for
 	  details.
 
+config TPL_LEGACY_IMAGE_FORMAT
+	bool "Support TPL loading and booting of Legacy images"
+	help
+	  TPL will support loading and booting Legacy images when this option
+	  is y. If this is not set, TPL will move on to other available
+	  boot media to find a suitable image. See SPL_LEGACY_IMAGE_FORMAT.
+
 config TPL_LIBCOMMON_SUPPORT
 	bool "Support common libraries"
 	help
