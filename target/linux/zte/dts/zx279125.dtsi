#include <dt-bindings/clock/zte,zx279125-clock.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "zte,zx279125";
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
			clocks = <&crm ZX279125_CLK_CPU>;
			clock-names = "cpu";
		};
	};

	osc: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <25000000>;
		clock-output-names = "osc";
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		interrupt-parent = <&gic>;
		ranges;

		gic: interrupt-controller@801000 {
			compatible = "arm,cortex-a9-gic";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0x00801000 0x1000>,
			      <0x00803000 0x1000>;
		};

		timer@400200 {
			compatible = "arm,cortex-a9-global-timer";
			reg = <0x00400200 0x100>;
			interrupts = <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_EDGE_RISING)>;
			clocks = <&crm ZX279125_CLK_CPU>;
		};

		crm: clock-controller@94000000 {
			compatible = "zte,zx279125-crm";
			reg = <0x94000000 0x1000>;
			#clock-cells = <1>;
			clocks = <&osc>;
			clock-names = "osc";
		};

		uart0: serial@94405000 {
			compatible = "ns16550a";
			reg = <0x94405000 0x1000>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crm ZX279125_CLK_UART0>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		uart1: serial@94406000 {
			compatible = "ns16550a";
			reg = <0x94406000 0x1000>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crm ZX279125_CLK_UART1>;
			reg-shift = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		spifc: spi@9a101000 {
			compatible = "zte,zx279125-spifc";
			reg = <0x9a101000 0x1000>;
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crm ZX279125_CLK_SPIFC>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gpio: gpio@9a102000 {
			compatible = "zte,zx279125-gpio";
			reg = <0x9a102000 0x1000>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			gpio-controller;
			#gpio-cells = <2>;
			status = "disabled";
		};

		pon: pon@92040000 {
			compatible = "zte,zx279125-pon";
			reg = <0x92040000 0x100>,
			      <0x920c0000 0x1000>,
			      <0x920d0000 0x1000>,
			      <0x920d4000 0x1000>,
			      <0x920d8000 0x1000>,
			      <0x92100000 0x1000>;
			reg-names = "intc", "gpon", "gem", "onu", "tx", "aes";
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crm ZX279125_CLK_GMAC>;
			status = "disabled";
		};
	};
};
