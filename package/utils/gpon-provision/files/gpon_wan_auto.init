#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Once per boot: when the WAN still has no default route two minutes after O5, gpon-wan-discover --auto.

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c 'i=0; while [ $i -lt 600 ] && ! grep -q "^onu_state: 5" /proc/gpon_health 2> /dev/null; do sleep 5; i=$((i + 5)); done; sleep 120; exec /usr/sbin/gpon-wan-discover --auto'
	procd_close_instance
}
