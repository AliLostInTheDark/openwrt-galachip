# Per-board GPON ONU identity. Lives on the RW overlay; editable via LuCI.
# 'factory' (default) reads MAC/OUI/SN from this unit's own flash config
# partition at boot, so one image self-provisions the whole fleet. Set
# 'manual' to override with the values below (e.g. a swapped/relabelled unit); a value
# left empty keeps the factory one.
# Factory data on flash is never rewritten by this package.

config gpon 'identity'
	option source 'factory'
	# Factory-sourced (leave empty under 'factory'; shown read-only in LuCI):
	option mac ''
	option oui ''
	option sn ''
	# Operator-configurable GPON auth (override via LuCI; empty = use factory value if present):
	option loid ''
	option loid_passwd ''
	option ploam_passwd ''
	option pon_vendor_id ''

config gpon 'storage'
	# MTD partition (name in /proc/mtd, or an absolute /dev path) holding the apmib blocks:
	option config_part 'config'
	# Partition holding the GN25L95 calibration file; defaults to "osk" when the
	# board has one (VSOL RTOS boards), else to config_part:
	#option cal_part 'osk'
	# L2 netdev that receives the per-board MAC before the network starts:
	option base_ifname 'eth0'
