#!/bin/sh
# Collect what is needed to debug OMCI provisioning against an OLT.
#   omci-diag          print status, the PON driver's state and log, the
#                      OLT <-> ONU summary and the OMCI log
#   omci-diag report   the decoded OLT <-> ONU conversation (omci-report):
#                      PLOAM and OMCI both ways, failures, the datapath
#   omci-diag trace    start or stop recording every OMCI exchange
#   omci-diag full [S] record S seconds (default 60) of OMCI, then print
#                      everything, the full report included; a recording
#                      started earlier with "trace" (or at boot with
#                      omci.main.trace=1) is kept
#   omci-diag split [S] everything "full" prints without its wait, then S
#                      seconds (default 60) of per-GEM upstream bytes every
#                      5 s, for a run with traffic on a VLAN split by p-bit
trace=/tmp/omcid-trace.txt

trace_toggle() {
	pid=$(pidof omcid) || { echo "omcid is not running" >&2; exit 1; }
	kill -USR1 "$pid"
}

tracing() {
	ls -l "/proc/$(pidof omcid)/fd" 2>/dev/null | grep -q "$trace"
}

section() {
	[ -r "$2" ] || return 0
	echo "== $1 ($2)"
	if [ -n "$3" ]; then tail -n "$3" "$2"; else cat "$2"; fi
}

case "$1" in
report)
	exec omci-report
	;;
trace)
	trace_toggle
	echo "OMCI trace toggled: a recording goes to $trace and stops at 1 MiB"
	exit 0
	;;
full)
	if ! tracing; then
		rm -f "$trace"
		trace_toggle
	fi
	echo "recording OMCI for ${2:-60} s..." >&2
	sleep "${2:-60}"
	trace_toggle
	;;
esac

echo "== omcictl status"
omcictl status
for dev in /sys/class/xpon/*; do
	[ -r "$dev/device/gpon_state" ] || continue
	echo "== $(basename "$dev")"
	cat "$dev/device/gpon_state"
done
section "PON driver" /proc/gpon
section "PON driver log" /proc/gpon_log 120
for attr in l2_offload l2_offload_bindings l2_offload_rules l2_offload_counters \
	qos_status sfu_untag_vlan sfu_vlan_map sfu_lan_tagged; do
	section "L2 $attr" "/sys/class/net/pon0/device/$attr"
done
if [ "$1" = full ] || [ "$1" = split ]; then
	section "OLT PLOAM capture" /proc/ploamcap
	section "OLT OMCI capture" /proc/oltcap
	section "PLOAM not understood" /proc/ploam_unknown
	section "OMCI not understood" /proc/gpon_unknown
fi
echo
if [ "$1" = full ] || [ "$1" = split ]; then omci-report; else omci-report -b; fi
echo
echo "== log"
logread | grep -i "omci\|gpon\|xpon\|Alloc-ID" | tail -n 200

[ "$1" = split ] || exit 0
echo
echo "== fault codes"
dmesg | grep -E '\[(L2|PON|OMC|QOS|SYS)-[0-9]+\]|L2 offload' | tail -n 60
echo "== bridge"
cat /sys/class/net/br-lan/bridge/vlan_filtering
uci show network | grep -A4 bridge-vlan
echo "== per-GEM upstream, bytes since the last line, for ${2:-60} s"
grep '^xflow' /proc/gpon > /dev/null
left=${2:-60}
while [ "$left" -gt 0 ]; do
	sleep 5
	left=$((left - 5))
	echo "-- ${left} s left, $(cut -d' ' -f1 /proc/uptime) s up; CPU: $(top -b -n1 | grep '^CPU:')"
	grep '^xflow' /proc/gpon | sed 's/ tcfg=[^ ]*//; s/ | .*//'
done
echo "== port counters"
ethtool -S eth0 | grep -E 'p[0-3]_(rx|tx)_octets|p[0-3]_tx_(discards|bridge_discards)'
