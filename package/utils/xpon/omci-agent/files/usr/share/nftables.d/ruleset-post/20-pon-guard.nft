# No management access from the PON: when pon0 is a bridge port, frames
# from the OLT side may cross the bridge but never reach this router.
# The OMCI management IP host has its own path and is not affected.
# fw4 includes this on every reload: replace the table, never stack it.
table bridge pon_guard
delete table bridge pon_guard

table bridge pon_guard {
	chain input {
		type filter hook input priority filter; policy accept;
		iifname "pon0*" counter drop
	}
}
