+#ifdef CONFIG_CPU_R3K_TLB
+/*
+ * The RLX "Taroko" core provides a single-shot cache-control register (CP0
+ * $20) that writes back+invalidates the whole D-cache and invalidates the
+ * whole I-cache regardless of geometry.  The per-line "cache" instruction
+ * also works on this core (used for the DMA paths), but for the whole-cache
+ * maintenance hooks we issue this register op: it is geometry-independent so
+ * correctness never depends on the probed line/size being exact, and these
+ * hooks are off the per-packet datapath so the extra work is immaterial.
+ *
+ * Operation bits: 0x200 = D writeback+invalidate, 0x002 = I invalidate.
+ * Order is D-before-I (push dirty data lines to memory, then drop stale
+ * instruction lines); a sync separates them.  The register self-completes,
+ * so no done-bit poll is needed.
+ */
+#define LUNA_CCTL_D_WBINV	0x200
+#define LUNA_CCTL_I_INV		0x002
+
+static inline void luna_flush_cache_all(void)
+{
+	__asm__ __volatile__(
+		"	.set	push		\n"
+		"	.set	noreorder	\n"
+		"	mtc0	$0, $20		\n"	/* arm: clear control */
+		"	nop; nop		\n"
+		"	mtc0	%0, $20		\n"	/* D writeback+invalidate */
+		"	nop; nop		\n"
+		"	sync			\n"
+		"	mtc0	$0, $20		\n"
+		"	nop; nop		\n"
+		"	mtc0	%1, $20		\n"	/* I invalidate */
+		"	nop; nop		\n"
+		"	.set	pop		\n"
+		:
+		: "r" (LUNA_CCTL_D_WBINV), "r" (LUNA_CCTL_I_INV)
+		: "memory");
+}
+#endif /* CONFIG_CPU_R3K_TLB */
