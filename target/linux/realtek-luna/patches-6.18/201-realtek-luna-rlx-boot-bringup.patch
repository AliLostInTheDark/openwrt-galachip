realtek-luna: RLX kernel bring-up to a running system tick + userspace

Clean-room RLX (RTL9602C "Taroko") fixes: -march=mips2 codegen (no SPECIAL2
before trap_init), CPU_RLX_TAROKO cpu-type map, fixed primary-cache geometry
(no Config0/1, no prefetch), R3000 (rfe) exception model on CPU_R3K_TLB, BUG_ON
branch-to-break, cache-flush barriers, module-reloc / kexec / r4kcache support.

--- a/arch/mips/Makefile
+++ b/arch/mips/Makefile
@@ -158,7 +158,20 @@
 cflags-$(CONFIG_CPU_R4300)	+= $(call cc-option,-march=r4300,-march=mips3) -Wa,--trap
 cflags-$(CONFIG_CPU_R4X00)	+= $(call cc-option,-march=r4600,-march=mips3) -Wa,--trap
 cflags-$(CONFIG_CPU_TX49XX)	+= $(call cc-option,-march=r4600,-march=mips3) -Wa,--trap
+ifeq ($(CONFIG_CPU_R3K_TLB),y)
+# The RLX ("Taroko") core uses the MIPS32 TLB/cache config but its ALU traps the
+# SPECIAL2 multiply/count-leading group (mul/madd/msub/clz/clo) that a mips32
+# toolchain emits.  Those faults are emulated on the reserved-instruction path,
+# which is not installed yet for hot code reached before trap setup (e.g. the
+# first sched_clock() from the boot banner) -> early hang.  Build MIPS II code
+# instead: it keeps ll/sc but uses mult/mflo for multiply and branches for
+# conditional-move/count, so none of the trapped opcodes are produced.  Also
+# suppress the divide-by-zero conditional trap.  (cache/sync/ll-sc asm carry
+# their own .set wrappers.)
+cflags-$(CONFIG_CPU_MIPS32_R1)	+= -march=mips2 -Wa,--trap -mno-check-zero-division
+else
 cflags-$(CONFIG_CPU_MIPS32_R1)	+= -march=mips32 -Wa,--trap
+endif
 cflags-$(CONFIG_CPU_MIPS32_R2)	+= -march=mips32r2 -mtune=24kc -Wa,--trap
 cflags-$(CONFIG_CPU_MIPS32_R5)	+= -march=mips32r5 -Wa,--trap -modd-spreg
 cflags-$(CONFIG_CPU_MIPS32_R6)	+= -march=mips32r6 -Wa,--trap -modd-spreg
--- a/arch/mips/include/asm/bug.h
+++ b/arch/mips/include/asm/bug.h
@@ -17,7 +17,15 @@
 
 #define HAVE_ARCH_BUG
 
-#if (_MIPS_ISA > _MIPS_ISA_MIPS1)
+/*
+ * The conditional-trap (tne) form of BUG_ON below is only valid on cores that
+ * implement the MIPS II+ trap instructions.  The RLX "Taroko" core is declared
+ * MIPS32 (so _MIPS_ISA > MIPS1) but, like an R3000, does not implement the
+ * conditional traps, so exclude the R3000-style cores (CONFIG_CPU_R3K_TLB) and
+ * fall back to the generic branch-to-break BUG_ON -- there the break is only
+ * reached on the failing branch, never executed unconditionally.
+ */
+#if (_MIPS_ISA > _MIPS_ISA_MIPS1) && !defined(CONFIG_CPU_R3K_TLB)
 
 static inline void  __BUG_ON(unsigned long condition)
 {
