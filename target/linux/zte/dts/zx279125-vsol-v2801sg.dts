/dts-v1/;
#include "zx279125.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "VSOL V2801SG";
	compatible = "v-sol,v2801sg", "zte,zx279125";

	aliases {
		serial0 = &uart0;
		i2c0 = &i2c0;
	};

	chosen {
		bootargs = "console=ttyS0,115200n8 earlycon initramfs_async=0";
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x01000000>,
		      <0x41a00000 0x00600000>; /* 22 MiB total for Linux */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Hardware PP DMA buffers and rings (10 MiB) */
		packet_pool: packet-pool@41000000 {
			reg = <0x41000000 0x00a00000>;
			no-map;
		};
	};
};

&uart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	bosa: optical-transceiver@51 {
		compatible = "semtech,gn25l95", "atmel,24c02";
		reg = <0x51>;
	};
};

&pon {
	status = "okay";
	zte,bosa-i2c = <&i2c0>;
};

&mdio {
	status = "okay";

	lan_phy: ethernet-phy@1 {
		reg = <1>;
	};
};

&ethernet {
	status = "okay";
	phy-handle = <&lan_phy>;
	memory-region = <&packet_pool>;
	/* CPU-only queue cursor table placed in reserved PP memory */
	zte,bootloader-cursors = <0x41840000>;
};

&spifc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				compatible = "openwrt,uimage", "denx,uimage";
				openwrt,offset = <320>;
				openwrt,partition-magic = <0x99999999>;
				label = "firmware";
				reg = <0x040000 0x740000>;
			};

			partition@780000 {
				label = "others";
				reg = <0x780000 0x010000>;
			};

			partition@790000 {
				label = "tagparam";
				reg = <0x790000 0x010000>;
			};

			partition@7a0000 {
				label = "usercfg";
				reg = <0x7a0000 0x060000>;
			};
		};
	};
};
