Index: linux-6.18.31/arch/mips/kernel/traps.c
===================================================================
--- linux-6.18.31.orig/arch/mips/kernel/traps.c
+++ linux-6.18.31/arch/mips/kernel/traps.c
@@ -1150,6 +1150,119 @@ out_sigsegv:
 	goto out;
 }
 
+#ifdef CONFIG_CPU_R3K_TLB
+/*
+ * The RLX "Taroko" core implements the MIPS-I integer base but not a handful of
+ * later opcodes a mips32 toolchain still emits: the SPECIAL2 multiply /
+ * count-leading group (mul, madd[u], msub[u], clz, clo) and the conditional
+ * TRAP instructions (tge/tgeu/tlt/tltu/teq/tne, used for divide-by-zero and
+ * overflow checks).  Emulate them on the reserved-instruction path so both
+ * kernel and user code built for mips32 run unmodified.
+ *
+ * Returns 1 if the faulting instruction was handled (EPC advanced for a normal
+ * op or a no-op trap, or a signal raised for a taken trap), 0 if it is not one
+ * of ours and the generic handling should continue.
+ */
+static int rlx_emulate_insn(struct pt_regs *regs)
+{
+	unsigned long pc = exception_epc(regs);
+	unsigned int opcode, rs, rt, rd, func;
+	long va, vb;
+
+	if (get_isa16_mode(regs->cp0_epc))
+		return 0;
+
+	if (user_mode(regs)) {
+		if (get_user(opcode, (unsigned int __user *)pc))
+			return 0;
+	} else {
+		opcode = *(unsigned int *)pc;
+	}
+
+	rs   = (opcode >> 21) & 0x1f;
+	rt   = (opcode >> 16) & 0x1f;
+	rd   = (opcode >> 11) & 0x1f;
+	func =  opcode        & 0x3f;
+	va = (long)regs->regs[rs];
+	vb = (long)regs->regs[rt];
+
+	switch (opcode >> 26) {
+	case 0x1c:				/* SPECIAL2 */
+		switch (func) {
+		case 0x02:			/* mul rd, rs, rt */
+			if (rd)
+				regs->regs[rd] = (s32)((s32)va * (s32)vb);
+			break;
+		case 0x00:			/* madd  rs, rt */
+		case 0x01: {			/* maddu rs, rt */
+			u64 acc = ((u64)(u32)regs->hi << 32) | (u32)regs->lo;
+			u64 p = (func == 0x00)
+			      ? (u64)((s64)(s32)va * (s32)vb)
+			      : (u64)((u32)va) * (u32)vb;
+			acc += p;
+			regs->lo = (s32)(u32)acc;
+			regs->hi = (s32)(u32)(acc >> 32);
+			break;
+		}
+		case 0x04:			/* msub  rs, rt */
+		case 0x05: {			/* msubu rs, rt */
+			u64 acc = ((u64)(u32)regs->hi << 32) | (u32)regs->lo;
+			u64 p = (func == 0x04)
+			      ? (u64)((s64)(s32)va * (s32)vb)
+			      : (u64)((u32)va) * (u32)vb;
+			acc -= p;
+			regs->lo = (s32)(u32)acc;
+			regs->hi = (s32)(u32)(acc >> 32);
+			break;
+		}
+		case 0x20:			/* clz rd, rs */
+			if (rd)
+				regs->regs[rd] =
+					(u32)va ? __builtin_clz((u32)va) : 32;
+			break;
+		case 0x21:			/* clo rd, rs */
+			if (rd)
+				regs->regs[rd] =
+					(u32)~va ? __builtin_clz((u32)~va) : 32;
+			break;
+		default:
+			return 0;
+		}
+		compute_return_epc(regs);
+		return 1;
+
+	case 0x00: {				/* SPECIAL: conditional traps */
+		int taken;
+
+		switch (func) {
+		case 0x30: taken = (va >= vb); break;			/* tge  */
+		case 0x31: taken = ((unsigned long)va >=
+				    (unsigned long)vb); break;		/* tgeu */
+		case 0x32: taken = (va <  vb); break;			/* tlt  */
+		case 0x33: taken = ((unsigned long)va <
+				    (unsigned long)vb); break;		/* tltu */
+		case 0x34: taken = (va == vb); break;			/* teq  */
+		case 0x36: taken = (va != vb); break;			/* tne  */
+		default:
+			return 0;
+		}
+		if (!taken) {
+			compute_return_epc(regs);	/* no-op: skip it */
+			return 1;
+		}
+		/* condition true: divide-by-zero / overflow check fired */
+		if (user_mode(regs))
+			force_sig(SIGFPE);
+		else
+			die_if_kernel("Trap instruction in kernel code", regs);
+		return 1;
+	}
+	}
+
+	return 0;
+}
+#endif /* CONFIG_CPU_R3K_TLB */
+
