#!/bin/sh /etc/rc.common
# GPON WAN cold-start auto-recovery watchdog: reboots until the OLT provisions
# the ONU, working around the non-deterministic power-on US analog lock. The
# lock cannot be re-rolled at runtime; only a power-on reboot re-rolls it. See
# /usr/sbin/gpon-wan-recover. Entirely ONU-side. Disable with `ENABLE=0` in
# /etc/gpon-wan-recover.conf or `/etc/init.d/gpon-wan-recover disable`.
# SPDX-License-Identifier: GPL-2.0-or-later
START=99
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/gpon-wan-recover ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/gpon-wan-recover
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
