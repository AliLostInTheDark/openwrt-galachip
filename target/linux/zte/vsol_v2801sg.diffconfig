# Seed configuration for the VSOL V2801SG.
# Usage: cp target/linux/zte/vsol_v2801sg.diffconfig .config && make defconfig
CONFIG_TARGET_zte=y
CONFIG_TARGET_zte_zx279125=y
CONFIG_TARGET_zte_zx279125_DEVICE_vsol_v2801sg=y
CONFIG_DEVEL=y
CONFIG_BUSYBOX_CUSTOM=y
# CONFIG_BUSYBOX_CONFIG_BRCTL is not set
# CONFIG_BUSYBOX_CONFIG_CHGRP is not set
# CONFIG_BUSYBOX_CONFIG_CHROOT is not set
# CONFIG_BUSYBOX_CONFIG_CLEAR is not set
# CONFIG_BUSYBOX_CONFIG_CMP is not set
# CONFIG_BUSYBOX_CONFIG_CROND is not set
# CONFIG_BUSYBOX_CONFIG_CRONTAB is not set
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
# CONFIG_BUSYBOX_CONFIG_DU is not set
# CONFIG_BUSYBOX_CONFIG_FSYNC is not set
# CONFIG_BUSYBOX_CONFIG_IFCONFIG is not set
# CONFIG_BUSYBOX_CONFIG_LESS is not set
CONFIG_BUSYBOX_CONFIG_MKSWAP=y
# CONFIG_BUSYBOX_CONFIG_NETMSG is not set
# CONFIG_BUSYBOX_CONFIG_NICE is not set
# CONFIG_BUSYBOX_CONFIG_NSLOOKUP is not set
# CONFIG_BUSYBOX_CONFIG_NTPD is not set
# CONFIG_BUSYBOX_CONFIG_RESET is not set
# CONFIG_BUSYBOX_CONFIG_RESIZE is not set
# CONFIG_BUSYBOX_CONFIG_ROUTE is not set
# CONFIG_BUSYBOX_CONFIG_SHA256SUM is not set
CONFIG_BUSYBOX_CONFIG_SWAPOFF=y
CONFIG_BUSYBOX_CONFIG_SWAPON=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_DISCARD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_PRI=y
# CONFIG_PACKAGE_kmod-zram is not set
# CONFIG_PACKAGE_zram-swap is not set
# CONFIG_BUSYBOX_CONFIG_TASKSET is not set
# CONFIG_BUSYBOX_CONFIG_TEE is not set
# CONFIG_BUSYBOX_CONFIG_TIME is not set
# CONFIG_BUSYBOX_CONFIG_TRACEROUTE6 is not set
# CONFIG_BUSYBOX_CONFIG_UDHCPC is not set
# CONFIG_BUSYBOX_CONFIG_VI is not set
# CONFIG_BUSYBOX_CONFIG_WHICH is not set
# CONFIG_BUSYBOX_CONFIG_YES is not set
CONFIG_DROPBEAR_ED25519=y
# CONFIG_DROPBEAR_RSA is not set
CONFIG_IMAGEOPT=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_IPV6_MROUTE is not set
# CONFIG_KERNEL_IP_MROUTE is not set
CONFIG_KERNEL_KALLSYMS=y
# CONFIG_KERNEL_SECCOMP is not set
# CONFIG_PACKAGE_apk-mbedtls is not set
CONFIG_PACKAGE_epon-oamd=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_bosa-tools=y
CONFIG_PACKAGE_libmbedtls=m
CONFIG_PACKAGE_libomci-protocol=y
# CONFIG_PACKAGE_libuclient is not set
CONFIG_PACKAGE_libustream-mbedtls=m
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-epon=y
CONFIG_PACKAGE_luci-app-omci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_omci-agent=y
CONFIG_PACKAGE_omci-monitor=y
CONFIG_PACKAGE_omcid=y
# CONFIG_PACKAGE_openwrt-keyring is not set
CONFIG_PACKAGE_phytool=y
# CONFIG_PACKAGE_uclient-fetch is not set
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
# CONFIG_PACKAGE_usign is not set
CONFIG_PACKAGE_xpon-diagnostics=y
# CONFIG_PACKAGE_zlib is not set
CONFIG_PREINITOPT=y
# CONFIG_SIGNATURE_CHECK is not set
# CONFIG_SIGNED_PACKAGES is not set
CONFIG_TARGET_PREINIT_SUPPRESS_FAILSAFE_NETMSG=y
CONFIG_TARGET_PREINIT_TIMEOUT=1
# CONFIG_USE_SECCOMP is not set
CONFIG_KERNEL_SWAP=y
CONFIG_PACKAGE_u-boot-vsol_v2801sg=y
