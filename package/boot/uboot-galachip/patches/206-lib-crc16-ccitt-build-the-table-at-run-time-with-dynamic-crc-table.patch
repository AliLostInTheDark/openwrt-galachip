From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] lib: crc16-ccitt: build the table at run time with DYNAMIC_CRC_TABLE

DYNAMIC_CRC_TABLE calculates the CRC tables at run time to make the image
smaller, but only crc32.c follows it. Do the same for the 512-byte table
of crc16-ccitt.c, which YMODEM uses, so it can move from a small boot
phase's image into its BSS. The host tools keep the constant table.

diff --git a/lib/crc16-ccitt.c b/lib/crc16-ccitt.c
index 6fa4e93e..3e82a80a 100644
--- a/lib/crc16-ccitt.c
+++ b/lib/crc16-ccitt.c
@@ -28,6 +28,22 @@
 #include <u-boot/crc.h>
 
 /* Table of CRC constants - implements x^16+x^12+x^5+1 */
+#if defined(CONFIG_DYNAMIC_CRC_TABLE) && !defined(USE_HOSTCC)
+static uint16_t crc16_tab[256];
+
+static void make_crc16_table(void)
+{
+	uint16_t c;
+	int n, k;
+
+	for (n = 0; n < 256; n++) {
+		c = n << 8;
+		for (k = 0; k < 8; k++)
+			c = c & 0x8000 ? (c << 1) ^ 0x1021 : c << 1;
+		crc16_tab[n] = c;
+	}
+}
+#else
 static const uint16_t crc16_tab[] = {
 	0x0000, 0x1021, 0x2042, 0x3063, 0x4084, 0x50a5, 0x60c6, 0x70e7,
 	0x8108, 0x9129, 0xa14a, 0xb16b, 0xc18c, 0xd1ad, 0xe1ce, 0xf1ef,
@@ -62,9 +78,14 @@ static const uint16_t crc16_tab[] = {
 	0xef1f, 0xff3e, 0xcf5d, 0xdf7c, 0xaf9b, 0xbfba, 0x8fd9, 0x9ff8,
 	0x6e17, 0x7e36, 0x4e55, 0x5e74, 0x2e93, 0x3eb2, 0x0ed1, 0x1ef0,
 };
+#endif
 
 uint16_t crc16_ccitt(uint16_t cksum, const unsigned char *buf, int len)
 {
+#if defined(CONFIG_DYNAMIC_CRC_TABLE) && !defined(USE_HOSTCC)
+	if (!crc16_tab[1])
+		make_crc16_table();
+#endif
 	for (int i = 0;  i < len;  i++)
 		cksum = crc16_tab[((cksum>>8) ^ *buf++) & 0xff] ^ (cksum << 8);
 
