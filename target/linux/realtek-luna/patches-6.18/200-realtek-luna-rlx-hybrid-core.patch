Index: linux-6.18.31/arch/mips/mm/tlbex.c
===================================================================
--- linux-6.18.31.orig/arch/mips/mm/tlbex.c
+++ linux-6.18.31/arch/mips/mm/tlbex.c
@@ -1867,10 +1867,25 @@ build_r3000_tlbchange_handler_head(u32 *
 	uasm_i_srl(p, pte, pte, 22); /* load delay */
 	uasm_i_sll(p, pte, pte, 2);
 	uasm_i_addu(p, ptr, ptr, pte);
+	/*
+	 * The RLX core only refills the Context register's BadVPN field on a
+	 * TLB-refill miss, not on the load/store/modify exceptions that reach
+	 * this change handler, so recover the page-table index from BadVAddr
+	 * instead: VA bits [21:12] select the pte within its page, scaled by 4
+	 * -> (BadVAddr >> 10) & 0xffc.
+	 */
