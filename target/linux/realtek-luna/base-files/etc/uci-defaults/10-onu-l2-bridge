#!/bin/sh
# Boards run as a pure L2 bridge: the PON joins br-lan and there is no routed
# WAN, so the router-mode WAN discovery stays off.

board=""
[ -r /tmp/sysinfo/board_name ] && board=$(cat /tmp/sysinfo/board_name)

case "$board" in
vsol,v2802rh)
	uci -q delete network.wan
	uci -q delete network.wan6
	# omcid's PON netdev; omci.main.untag_vlan names the VLAN the LAN
	# sends untagged
	uci -q del_list network.@device[0].ports='pon0'
	uci -q add_list network.@device[0].ports='pon0'
	uci -q commit network
	uci -q set gpon.wan_auto.enabled='0'
	uci -q commit gpon
	;;
esac

exit 0
