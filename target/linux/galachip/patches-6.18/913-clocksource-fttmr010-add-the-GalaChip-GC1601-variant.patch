From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: clocksource/drivers/fttmr010: add the GalaChip GC1601 variant

The GC1601 timer is an FTTMR010 that counts down like the Aspeed ones but
keeps the interrupt status and mask registers. A one in the mask register
masks an interrupt, the status is cleared by writing a one, and timer 1
raises its interrupt again only after its status was cleared. Without the
clear the board took one clock event and then stopped at the first sleep.

Count down from the programmed value and interrupt on the overflow, in
one-shot and periodic mode, and acknowledge the status in the handler.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
--- a/drivers/clocksource/timer-fttmr010.c
+++ b/drivers/clocksource/timer-fttmr010.c
@@ -95,11 +95,17 @@
 #define TIMER_3_INT_MATCH2	BIT(7)
 #define TIMER_3_INT_OVERFLOW	BIT(8)
 #define TIMER_INT_ALL_MASK	0x1ff
+#define TIMER_1_INT_ALL		GENMASK(2, 0)
 
 struct fttmr010 {
 	void __iomem *base;
 	unsigned int tick_rate;
 	bool is_aspeed;
+	/*
+	 * The GC1601 counts down, masks an interrupt with a one, clears its
+	 * status by writing a one and raises timer 1 again only after that.
+	 */
+	bool is_gc1601;
 	u32 t1_enable_val;
 	struct clock_event_device clkevt;
 	int (*timer_shutdown)(struct clock_event_device *evt);
@@ -154,6 +160,9 @@
 		 * into TIMER1_COUNT register when the timer is re-enabled.
 		 */
 		writel(cycles, fttmr010->base + TIMER1_LOAD);
+	} else if (fttmr010->is_gc1601) {
+		/* Count down from here and interrupt on the overflow */
+		writel(cycles, fttmr010->base + TIMER1_COUNT);
 	} else {
 		/* Setup the match register forward in time */
 		cr = readl(fttmr010->base + TIMER1_COUNT);
@@ -191,6 +200,23 @@
 	return 0;
 }
 
+static int gc1601_timer_shutdown(struct clock_event_device *evt)
+{
+	struct fttmr010 *fttmr010 = to_fttmr010(evt);
+
+	fttmr010_timer_shutdown(evt);
+	/* A stale status would block the next interrupt */
+	writel(TIMER_1_INT_ALL, fttmr010->base + TIMER_INTR_STATE);
+
+	return 0;
+}
+
+static void gc1601_timer_unmask(struct fttmr010 *fttmr010)
+{
+	writel(TIMER_INT_ALL_MASK & ~TIMER_1_INT_ALL,
+	       fttmr010->base + TIMER_INTR_MASK);
+}
+
 static int fttmr010_timer_set_oneshot(struct clock_event_device *evt)
 {
 	struct fttmr010 *fttmr010 = to_fttmr010(evt);
@@ -203,6 +229,9 @@
 	writel(0, fttmr010->base + TIMER1_COUNT);
 	if (fttmr010->is_aspeed) {
 		writel(~0, fttmr010->base + TIMER1_LOAD);
+	} else if (fttmr010->is_gc1601) {
+		writel(0, fttmr010->base + TIMER1_LOAD);
+		gc1601_timer_unmask(fttmr010);
 	} else {
 		writel(0, fttmr010->base + TIMER1_LOAD);
 
@@ -228,6 +257,10 @@
 	/* Setup timer to fire at 1/HZ intervals. */
 	if (fttmr010->is_aspeed) {
 		writel(period, fttmr010->base + TIMER1_LOAD);
+	} else if (fttmr010->is_gc1601) {
+		writel(period, fttmr010->base + TIMER1_COUNT);
+		writel(period, fttmr010->base + TIMER1_LOAD);
+		gc1601_timer_unmask(fttmr010);
 	} else {
 		cr = 0xffffffff - (period - 1);
 		writel(cr, fttmr010->base + TIMER1_COUNT);
@@ -270,9 +303,24 @@
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t gc1601_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+	struct fttmr010 *fttmr010 = to_fttmr010(evt);
+
+	writel(TIMER_1_INT_ALL, fttmr010->base + TIMER_INTR_STATE);
+	if (clockevent_state_oneshot(evt))
+		fttmr010->timer_shutdown(evt);
+
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
 static int __init fttmr010_common_init(struct device_node *np,
-				       bool is_aspeed, bool is_ast2600)
+				       bool is_aspeed, bool is_ast2600,
+				       bool is_gc1601)
 {
+	bool count_down = is_aspeed || is_gc1601;
 	struct fttmr010 *fttmr010;
 	int irq;
 	struct clk *clk;
@@ -325,20 +373,24 @@
 		fttmr010->is_aspeed = true;
 	} else {
 		fttmr010->t1_enable_val = TIMER_1_CR_ENABLE | TIMER_1_CR_INT;
+		fttmr010->is_gc1601 = is_gc1601;
 
 		/*
 		 * Reset the interrupt mask and status
 		 */
 		writel(TIMER_INT_ALL_MASK, fttmr010->base + TIMER_INTR_MASK);
-		writel(0, fttmr010->base + TIMER_INTR_STATE);
+		writel(is_gc1601 ? TIMER_INT_ALL_MASK : 0,
+		       fttmr010->base + TIMER_INTR_STATE);
 	}
 
 	/*
-	 * Enable timer 1 count up, timer 2 count up, except on Aspeed,
-	 * where everything just counts down.
+	 * Enable timer 1 count up, timer 2 count up, except on Aspeed and
+	 * GC1601, where everything just counts down.
 	 */
 	if (is_aspeed)
 		val = TIMER_2_CR_ASPEED_ENABLE;
+	else if (is_gc1601)
+		val = TIMER_2_CR_ENABLE;
 	else {
 		val = TIMER_2_CR_ENABLE | TIMER_1_CR_UPDOWN |
 			TIMER_2_CR_UPDOWN;
@@ -354,7 +406,7 @@
 	writel(0, fttmr010->base + TIMER2_MATCH1);
 	writel(0, fttmr010->base + TIMER2_MATCH2);
 
-	if (fttmr010->is_aspeed) {
+	if (count_down) {
 		writel(~0, fttmr010->base + TIMER2_LOAD);
 		clocksource_mmio_init(fttmr010->base + TIMER2_COUNT,
 				      "FTTMR010-TIMER2",
@@ -385,6 +437,11 @@
 		ret = request_irq(irq, ast2600_timer_interrupt,
 				  IRQF_TIMER, "FTTMR010-TIMER1",
 				  &fttmr010->clkevt);
+	} else if (is_gc1601) {
+		fttmr010->timer_shutdown = gc1601_timer_shutdown;
+		ret = request_irq(irq, gc1601_timer_interrupt,
+				  IRQF_TIMER, "FTTMR010-TIMER1",
+				  &fttmr010->clkevt);
 	} else {
 		fttmr010->timer_shutdown = fttmr010_timer_shutdown;
 		ret = request_irq(irq, fttmr010_timer_interrupt,
@@ -414,7 +471,7 @@
 
 #ifdef CONFIG_ARM
 	/* Also use this timer for delays */
-	if (fttmr010->is_aspeed)
+	if (count_down)
 		fttmr010->delay_timer.read_current_timer =
 			fttmr010_read_current_timer_down;
 	else
@@ -438,17 +495,22 @@
 
 static __init int ast2600_timer_init(struct device_node *np)
 {
-	return fttmr010_common_init(np, true, true);
+	return fttmr010_common_init(np, true, true, false);
 }
 
 static __init int aspeed_timer_init(struct device_node *np)
 {
-	return fttmr010_common_init(np, true, false);
+	return fttmr010_common_init(np, true, false, false);
 }
 
 static __init int fttmr010_timer_init(struct device_node *np)
 {
-	return fttmr010_common_init(np, false, false);
+	return fttmr010_common_init(np, false, false, false);
+}
+
+static __init int gc1601_timer_init(struct device_node *np)
+{
+	return fttmr010_common_init(np, false, false, true);
 }
 
 TIMER_OF_DECLARE(fttmr010, "faraday,fttmr010", fttmr010_timer_init);
@@ -457,3 +519,4 @@
 TIMER_OF_DECLARE(ast2400, "aspeed,ast2400-timer", aspeed_timer_init);
 TIMER_OF_DECLARE(ast2500, "aspeed,ast2500-timer", aspeed_timer_init);
 TIMER_OF_DECLARE(ast2600, "aspeed,ast2600-timer", ast2600_timer_init);
+TIMER_OF_DECLARE(gc1601, "galachip,gc1601-timer", gc1601_timer_init);
