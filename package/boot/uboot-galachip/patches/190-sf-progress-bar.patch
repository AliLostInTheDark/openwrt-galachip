 			err_oper = spi_flash_update_block(flash, offset, todo,
 					buf, cmp_buf, &skipped);
 		}
+		if (!err_oper)
+			sf_progress("Updating", len, len, start_time);
 	} else {
 		err_oper = "malloc";
 	}
 	free(cmp_buf);
-	putc('\r');
+	putc('\n');
 	if (err_oper) {
 		printf("SPI flash failed in %s step\n", err_oper);
 		return 1;
 	}
 
-	delta = get_timer(start_time);
 	printf("%zu bytes written, %zu bytes skipped", len - skipped,
 	       skipped);
-	printf(" in %ld.%03lds, speed %ld KiB/s\n",
-	       delta / 1000, delta % 1000,
-	       bytes_per_second(len, start_time) / 1024);
+	sf_print_time(len, start_time);
+	putc('\n');
 
 	return 0;
 }
@@ -335,18 +380,24 @@
 			}
 		}
 
