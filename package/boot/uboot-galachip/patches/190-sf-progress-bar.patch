From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] cmd: sf: progress bar for erase, write and update

Erase and write ran as one call with no feedback, and update redrew
its percentage with a leading "   \r" that made the cursor jump. Erase
and write now run in 64 KiB steps; all three draw one fixed-width line
ending in a bar, then report time and speed.

--- a/cmd/sf.c	2026-11-03 01:55:26.968649213 +0530
+++ b/cmd/sf.c	2026-11-03 01:55:39.476241813 +0530
@@ -214,6 +214,57 @@
 	return NULL;
 }
 
+#define SF_PROGRESS_STEP	0x10000
+#define SF_PROGRESS_WIDTH	20
+
+/* One fixed-width line, redrawn in place: "<what>, 45% 123 KiB/s [#####   ]" */
+static void sf_progress(const char *what, size_t done, size_t total,
+			ulong start_time)
+{
+	char bar[SF_PROGRESS_WIDTH + 1];
+	size_t fill = done * SF_PROGRESS_WIDTH / total;
+
+	memset(bar, '#', fill);
+	memset(bar + fill, ' ', SF_PROGRESS_WIDTH - fill);
+	bar[SF_PROGRESS_WIDTH] = '\0';
+	printf("\r%s, %3zu%% %5lu KiB/s [%s]", what, done * 100 / total,
+	       bytes_per_second(done, start_time) / 1024, bar);
+}
+
+/* Erase or write in 64 KiB steps so a long operation shows progress. */
+static int sf_erase_write(struct spi_flash *flash, u32 offset, size_t len,
+			  const void *buf, ulong start_time)
+{
+	const char *what = buf ? "Writing" : "Erasing";
+	size_t done = 0;
+	int ret = 0;
+
+	while (done < len && !ret) {
+		size_t todo = min_t(size_t, len - done,
+				    SF_PROGRESS_STEP - (offset + done) % SF_PROGRESS_STEP);
+
+		if (buf)
+			ret = spi_flash_write(flash, offset + done, todo,
+					      buf + done);
+		else
+			ret = spi_flash_erase(flash, offset + done, todo);
+		done += todo;
+		if (len > SF_PROGRESS_STEP)
+			sf_progress(what, done, len, start_time);
+	}
+	if (len > SF_PROGRESS_STEP)
+		putc('\n');
+	return ret;
+}
+
+static void sf_print_time(size_t len, ulong start_time)
+{
+	ulong delta = get_timer(start_time);
+
+	printf(" in %ld.%03lds, speed %ld KiB/s", delta / 1000, delta % 1000,
+	       bytes_per_second(len, start_time) / 1024);
+}
+
 /**
