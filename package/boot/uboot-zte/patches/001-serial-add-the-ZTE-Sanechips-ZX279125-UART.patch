From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] serial: add the ZTE Sanechips ZX279125 UART

Add a driver model serial driver for the ZX279125 UART.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
diff --git a/drivers/serial/Kconfig b/drivers/serial/Kconfig
index ffc58d66..9063d91d 100644
--- a/drivers/serial/Kconfig
+++ b/drivers/serial/Kconfig
@@ -526,6 +526,12 @@ config DEBUG_UART_GOLDFISH
 	  start up driver model. The driver will be available until the real
 	  driver model serial is running.
 
+config DEBUG_UART_ZX279125
+	bool "ZTE ZX279125"
+	help
+	  Select this to enable a debug UART using the serial_zx279125 driver.
+	  This provides basic early serial output for ZTE Sanechips ZX279125 SoCs.
+
 endchoice
 
 config DEBUG_UART_BASE
@@ -1218,4 +1224,17 @@ config SERIAL_GOLDFISH
 	  This virtual device is commonly used by QEMU virtual machines
 	  (e.g. m68k virt) for console output.
 
+config ZX279125_SERIAL
+	bool "ZTE Sanechips ZX279125 UART support"
+	depends on DM_SERIAL
+	help
+	  Select this to enable UART driver support for ZTE Sanechips ZX279125 SoCs.
+
+config ZX279125_SERIAL_INIT
+	bool "Initialize ZX279125 UART from the bootloader"
+	depends on ZX279125_SERIAL
+	help
+	  Program the stock 115200 baud UART register sequence on a cold boot.
+	  Leave this disabled for the RAM chainload, which inherits a live UART.
+
 endif
diff --git a/drivers/serial/Makefile b/drivers/serial/Makefile
index 44fb2170..b91d64de 100644
--- a/drivers/serial/Makefile
+++ b/drivers/serial/Makefile
@@ -64,3 +64,4 @@ obj-$(CONFIG_S5P4418_PL011_SERIAL) += serial_s5p4418_pl011.o
 
 obj-$(CONFIG_UART4_SERIAL) += serial_adi_uart4.o
 obj-$(CONFIG_SERIAL_GOLDFISH) += serial_goldfish.o
+obj-$(CONFIG_ZX279125_SERIAL) += serial_zx279125.o
diff --git a/drivers/serial/serial_zx279125.c b/drivers/serial/serial_zx279125.c
new file mode 100644
index 00000000..dca41e62
--- /dev/null
+++ b/drivers/serial/serial_zx279125.c
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZTE Sanechips ZX279125 UART Driver
+ *
+ * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
+ */
+
+#include <dm.h>
+#include <serial.h>
+#include <asm/io.h>
+
+#define ZX_UART_DATA		0x04
+#define ZX_UART_ERROR		0x08
+#define ZX_UART_FLAGS		0x14
+#define ZX_UART_IBRD		0x24
+#define ZX_UART_FBRD		0x28
+#define ZX_UART_LINE		0x30
+#define ZX_UART_CONTROL		0x34
+#define ZX_UART_FIFO		0x38
+#define ZX_UART_INT_MASK	0x40
+
+#define ZX_UART_RX_EMPTY	(1 << 4)
+#define ZX_UART_TX_FULL		(1 << 5)
+#define ZX_UART_TX_EMPTY	(1 << 7)
+
+struct zx279125_serial_plat {
+	void __iomem *base;
+	unsigned int clock;
+};
+
+#ifdef CONFIG_ZX279125_SERIAL_INIT
+static void zx279125_serial_hw_init(void __iomem *base)
+{
+	writel_relaxed(0, base + ZX_UART_ERROR);
+	writel_relaxed(0, base + ZX_UART_CONTROL);
+	writel_relaxed(13, base + ZX_UART_IBRD);
+	writel_relaxed(36, base + ZX_UART_FBRD);
+	writel_relaxed(0x70, base + ZX_UART_LINE);
+	writel_relaxed(0, base + ZX_UART_INT_MASK);
+	writel_relaxed(0x301, base + ZX_UART_CONTROL);
+}
+#endif
+
+static int zx279125_serial_setbrg(struct udevice *dev, int baudrate)
+{
+	/*
+	 * The cold build programs the stock 115200 8N1 sequence at probe.
+	 * The RAM chainload preserves its already running UART.
+	 */
+	return 0;
+}
+
+static int zx279125_serial_putc(struct udevice *dev, const char c)
+{
+	struct zx279125_serial_plat *plat = dev_get_plat(dev);
+
+	if (readl(plat->base + ZX_UART_FLAGS) & ZX_UART_TX_FULL)
+		return -EAGAIN;
+
+	writel(c, plat->base + ZX_UART_DATA);
+	return 0;
+}
+
+static int zx279125_serial_pending(struct udevice *dev, bool input)
+{
+	struct zx279125_serial_plat *plat = dev_get_plat(dev);
+	u32 flags = readl(plat->base + ZX_UART_FLAGS);
+
+	if (input)
+		return (flags & ZX_UART_RX_EMPTY) ? 0 : 1;
+	else
+		return (flags & ZX_UART_TX_FULL) ? 1 : 0;
+}
+
+static int zx279125_serial_getc(struct udevice *dev)
+{
+	struct zx279125_serial_plat *plat = dev_get_plat(dev);
+
+	if (readl(plat->base + ZX_UART_FLAGS) & ZX_UART_RX_EMPTY)
+		return -EAGAIN;
+
+	return readl(plat->base + ZX_UART_DATA) & 0xff;
+}
+
+static int zx279125_serial_probe(struct udevice *dev)
+{
+#ifdef CONFIG_ZX279125_SERIAL_INIT
+	struct zx279125_serial_plat *plat = dev_get_plat(dev);
+
+	zx279125_serial_hw_init(plat->base);
+#endif
+
+	return 0;
+}
+
+static int zx279125_serial_of_to_plat(struct udevice *dev)
+{
+	struct zx279125_serial_plat *plat = dev_get_plat(dev);
+
+	plat->base = dev_read_addr_ptr(dev);
+	plat->clock = dev_read_u32_default(dev, "clock-frequency", 25000000);
+
+	return 0;
+}
+
+static const struct dm_serial_ops zx279125_serial_ops = {
+	.putc = zx279125_serial_putc,
+	.pending = zx279125_serial_pending,
+	.getc = zx279125_serial_getc,
+	.setbrg = zx279125_serial_setbrg,
+};
+
+static const struct udevice_id zx279125_serial_ids[] = {
+	{ .compatible = "zte,zx279125-uart" },
+	{ }
+};
+
+U_BOOT_DRIVER(serial_zx279125) = {
+	.name = "serial_zx279125",
+	.id = UCLASS_SERIAL,
+	.of_match = zx279125_serial_ids,
+	.of_to_plat = zx279125_serial_of_to_plat,
+	.plat_auto = sizeof(struct zx279125_serial_plat),
+	.probe = zx279125_serial_probe,
+	.ops = &zx279125_serial_ops,
+	.flags = DM_FLAG_PRE_RELOC,
+};
+
+#ifdef CONFIG_DEBUG_UART_ZX279125
+#include <debug_uart.h>
+
+static inline void _debug_uart_init(void)
+{
+	/* Stock U-Boot has already initialized the UART at 115200 8N1 */
+}
+
+static inline void _debug_uart_putc(int c)
+{
+	void __iomem *base = (void __iomem *)CONFIG_VAL(DEBUG_UART_BASE);
+
+	while (readl(base + ZX_UART_FLAGS) & ZX_UART_TX_FULL)
+		;
+
+	writel(c, base + ZX_UART_DATA);
+}
+
+DEBUG_UART_FUNCS
+
+#endif
