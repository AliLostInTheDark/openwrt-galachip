#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Enforce the OLT's OMCI multicast operations profile on the LAN bridge.

START=96
USE_PROCD=1

start_service() {
	[ "$(uci -q get xpon.main.mode)" = "epon" ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/omci-mcast
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/sbin/omci-mcast clear
}
