#!/usr/bin/ucode -S
// SPDX-License-Identifier: GPL-2.0-only
/*
 * Enforce the OLT's multicast operations profile on the LAN: the IGMP/MLD
 * version and timers of the bridge querier, immediate leave and the group
 * limit on its ports, and in nftables the upstream report rate and priority
 * and the group access control list. Values the OLT left at 0 keep the local
 * setting, and everything is put back when the profile goes away.
 *
 * Limits: igmpproxy always reports upstream as IGMPv2; an IGMPv3 report is
 * checked against the list by its first group record only; the bandwidth
 * limits are not enforced.
 */

import * as ubus from 'ubus';
import * as uloop from 'uloop';
import { readfile, writefile, popen } from 'fs';
import { cursor } from 'uci';
import { syslog, openlog, LOG_INFO, LOG_WARNING, LOG_DAEMON } from 'log';
import { CLASS, settings } from 'omci.mcast';

const POLL_MS = 5000;
const NFT_FILE = '/var/run/omci-mcast.nft';
const TABLE = 'omci_mcast';

let bus, applied = null, saved = {};

function log(level, fmt, ...args) {
	syslog(level, sprintf(fmt, ...args));
}

function lan_bridge() {
	return cursor().get('network', 'lan', 'device') ?? 'br-lan';
}

function bridge_ports(br) {
	let out = [], p = popen(`ls /sys/class/net/${br}/brif 2>/dev/null`);

	for (let l = p.read('line'); length(l); l = p.read('line'))
		push(out, trim(l));
	p.close();
	return out;
}

/* Write a sysfs knob, keeping its first value to restore later. */
function knob(path, value) {
	let old = trim(readfile(path) ?? '');

	if (!length(old))
		return;
	saved[path] ??= old;
	if (value == null)
		value = saved[path];
	if (old != `${value}`)
		writefile(path, `${value}`);
}

function restore() {
	for (let path, value in saved)
		writefile(path, value);
	saved = {};
}

function sh(cmd) {
	return system(cmd) == 0;
}

/* G.988 group ranges as an nftables interval set body */
function acl_elements(ranges) {
	return join(', ', map(ranges, r => r[0] == r[1] ? sprintf('0x%08x', r[0]) :
				    sprintf('0x%08x-0x%08x', r[0], r[1])));
}

function nft_rules(s) {
	let rules = [
		`table bridge ${TABLE}`, `delete table bridge ${TABLE}`,
		`table inet ${TABLE}`, `delete table inet ${TABLE}`,
	];

	if (length(s.acl)) {
		/*
		 * Bridge prerouting runs before the bridge snoops a report, so a
		 * group outside the list is never joined, locally or upstream.
		 * An IGMPv3 report has its first group record at offset 12.
		 */
		push(rules, `table bridge ${TABLE} {
	set acl { typeof igmp group; flags interval; elements = { ${acl_elements(s.acl)} } }
	chain pre {
		type filter hook prerouting priority -200; policy accept;
		igmp type membership-report-v2 igmp group != @acl counter drop
		igmp type membership-report-v3 @th,96,32 != @acl counter drop
	}
}`);
	}

	let out = [];
	if (s.upstream_rate) {
		push(out, `meta l4proto igmp limit rate over ${s.upstream_rate}/second counter drop`);
		push(out, `meta l4proto ipv6-icmp icmpv6 type { mld-listener-report, mld2-listener-report } limit rate over ${s.upstream_rate}/second counter drop`);
	}
	if (s.upstream_pcp != null)
		push(out, `meta l4proto igmp meta priority set 0:${s.upstream_pcp}`);
	if (length(out))
		push(rules, `table inet ${TABLE} {
	chain out {
		type filter hook output priority 0; policy accept;
		${join('\n\t\t', out)}
	}
}`);
	return join('\n', rules) + '\n';
}

function nft_clear() {
	writefile(NFT_FILE, `table bridge ${TABLE}\ndelete table bridge ${TABLE}\n` +
		  `table inet ${TABLE}\ndelete table inet ${TABLE}\n`);
	sh(`nft -f ${NFT_FILE}`);
}

/* sysfs takes the bridge timers in centiseconds */
function apply(s) {
	let br = lan_bridge(), base = `/sys/class/net/${br}/bridge`;
	let ok = true;

	knob(`${base}/multicast_igmp_version`, s.igmp_version);
	knob(`${base}/multicast_mld_version`, s.mld_version);
	knob(`${base}/multicast_last_member_count`, s.robustness || null);
	knob(`${base}/multicast_startup_query_count`, s.robustness || null);
	knob(`${base}/multicast_query_interval`,
	     s.query_interval_s ? s.query_interval_s * 100 : null);
	knob(`${base}/multicast_query_response_interval`,
	     s.query_response_ds ? s.query_response_ds * 10 : null);
	knob(`${base}/multicast_last_member_interval`,
	     s.last_member_ds ? s.last_member_ds * 10 : null);

	for (let port in bridge_ports(br)) {
		knob(`/sys/class/net/${port}/brport/multicast_fast_leave`,
		     s.fast_leave ? 1 : null);
		ok = sh(`bridge link set dev ${port} mcast_max_groups ${s.max_groups}`) && ok;
	}

	writefile(NFT_FILE, nft_rules(s));
	ok = sh(`nft -f ${NFT_FILE}`) && ok;

	if (s.max_bandwidth)
		log(LOG_INFO, 'multicast bandwidth limit %d not enforced', s.max_bandwidth);
	return ok;
}

function clear() {
	let br = lan_bridge();

	restore();
	for (let port in bridge_ports(br))
		sh(`bridge link set dev ${port} mcast_max_groups 0`);
	nft_clear();
}

function poll() {
	let mib = bus.call('omci.agent', 'mib_list',
			   { classes: [ CLASS.profile, CLASS.subscriber ] });
	let s = settings(mib?.objects ?? []);
	let key = sprintf('%J', s);

	if (key != applied) {
		if (s) {
			if (apply(s))
				log(LOG_INFO, 'OLT multicast profile 0x%04x applied: IGMPv%s, fast leave %s, rate %d/s, max groups %d, %d ACL ranges',
				    s.profile, s.igmp_version ?? '-', s.fast_leave ? 'on' : 'off',
				    s.upstream_rate, s.max_groups, length(s.acl));
			else
				log(LOG_WARNING, 'OLT multicast profile 0x%04x applied in part',
				    s.profile);
		} else if (applied != null) {
			clear();
			log(LOG_INFO, 'OLT multicast profile removed, local settings restored');
		}
		applied = key;
	}
	uloop.timer(POLL_MS, poll);
}

openlog('omci-mcast', 0, LOG_DAEMON);
uloop.init();
bus = ubus.connect();
if (!bus) {
	log(LOG_WARNING, 'cannot connect to ubus');
	exit(1);
}
poll();
uloop.run();
