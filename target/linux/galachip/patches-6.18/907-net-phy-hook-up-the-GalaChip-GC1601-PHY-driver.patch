From db9c48a93943a55c9a0fca83c067dbbbcb803f5e Mon Sep 17 00:00:00 2001
From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Date: Mon, 12 Oct 2026 23:38:45 +0530
Subject: [PATCH] net: phy: hook up the GalaChip GC1601 PHY driver

The GC1601's integrated gigabit PHY needs the stock tuning writes the
generic PHY driver does not do.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
 drivers/net/phy/Kconfig  | 5 +++++
 drivers/net/phy/Makefile | 1 +
 2 files changed, 6 insertions(+)

diff --git a/drivers/net/phy/Kconfig b/drivers/net/phy/Kconfig
index 2e6bd42f7..7c4c49877 100644
--- a/drivers/net/phy/Kconfig
+++ b/drivers/net/phy/Kconfig
@@ -170,6 +170,11 @@ config AS21XXX_PHY
 	  AS21210PB1 that all register with the PHY ID 0x7500 0x7500
 	  before the firmware is loaded.
 
+config GALACHIP_PHY
+	tristate "GalaChip GC1601 PHY"
+	help
+	  Supports the internal gigabit PHY of the GalaChip GC1601 SoC.
+
 config AIR_EN8811H_PHY
 	tristate "Airoha EN8811H 2.5 Gigabit PHY"
 	select PHY_COMMON_PROPS
diff --git a/drivers/net/phy/Makefile b/drivers/net/phy/Makefile
index 5ae15347c..e3a435143 100644
--- a/drivers/net/phy/Makefile
+++ b/drivers/net/phy/Makefile
@@ -45,6 +45,7 @@ obj-y				+= $(sfp-obj-y) $(sfp-obj-m)
 obj-$(CONFIG_ADIN_PHY)		+= adin.o
 obj-$(CONFIG_ADIN1100_PHY)	+= adin1100.o
 obj-$(CONFIG_AIR_EN8811H_PHY)   += air_en8811h.o
+obj-$(CONFIG_GALACHIP_PHY)	+= galachip.o
 obj-$(CONFIG_AMD_PHY)		+= amd.o
 obj-$(CONFIG_AMCC_QT2025_PHY)	+= qt2025.o
 obj-$(CONFIG_AQUANTIA_PHY)	+= aquantia/
-- 
2.43.0

