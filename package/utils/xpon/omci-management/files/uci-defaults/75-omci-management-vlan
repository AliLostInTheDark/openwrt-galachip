#!/bin/sh
# Repair the old UI's bridge-of-bridges configuration on upgrades.
. /lib/functions.sh

cpu_vlan=0
management_vlan() {
	local device vlan local_access
	config_get device "$1" device
	config_get vlan "$1" vlan
	config_get local_access "$1" local 1
	[ "$device" = br-lan ] && [ "$vlan" = 1 ] && [ "$local_access" != 0 ] && cpu_vlan=1
}

config_load network
config_get device lan device
config_get name omci_management name
config_get ports omci_management ports
[ "$device" = br-onu ] && [ "$name" = br-onu ] && [ "$ports" = br-lan ] || exit 0
config_foreach management_vlan bridge-vlan
[ "$cpu_vlan" = 1 ] || exit 0
uci -q delete network.omci_management.ports
uci add_list network.omci_management.ports='br-lan.1'
uci commit network
exit 0
