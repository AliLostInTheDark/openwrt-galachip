#!/bin/sh
#
# ★★★ STOP THIS BOARD CLAIMING ANOTHER BOARD'S LAN ADDRESS.
#
# `/etc/config/network` in this target is a FIXED FILE shipped verbatim to every
# board on it -- and taroko (RTL9602C, the X111W) and interaptiv (RTL9603CVD, the
# LANLY G24W) are two DIFFERENT products sharing it.
#
# ⚠ CORRECTED 2026-08-30: this paragraph said the shipped file hardcodes
# `192.168.1.1`. It no longer does -- it now ships `192.168.1.12`, the X111W's
# own address. That is BETTER (nothing lands on the banned .1 any more) and it
# does NOT retire this file: the G24W would still boot onto the X111W's address,
# which is the same cross-board collision one octet over. The history is kept
# because the reasoning below is what the .1 measurement paid for:
#
#   MEASURED 2026-08-20, on the lab rig, before this file existed:
#     192.168.1.1 dev eth0 lladdr 98:c7:a4:6c:af:cb REACHABLE
#   -- that is the X400AXF on bench `onu`, LIVE, on the SAME L2 segment as the
#   two other ONUs. The moment the LANLY G24W gained a working Ethernet driver,
#   booting this image would have put a SECOND host on 192.168.1.1 and started
#   ARP-flapping another agent's board mid-measurement.
#
# ⚠ AND IT WOULD HAVE BEEN SILENT. Nothing in the image, the build or the suite
# checks that two boards were handed the same address; the first symptom would
# have been somebody else's ssh session dying for no visible reason, on a bench
# nobody had touched.
#
# ★ THIS FILE IS A SYMPTOM, NOT THE CURE. The real defect is already declared in
# the project's own rules: our side is supposed to be generated by
# `config_generate(8)` / `board.d` from the board's declaration and its DT, and
# shipping ONE board's fixed topology to every board on the target is what
# disables that. Until the generator lands, this restores the ONE value that can
# do cross-board damage, and it does so per board, from the board's own name.
#
# ★ WHY uci-defaults AND NOT AN EDIT TO THE SHIPPED FILE: editing
# `/etc/config/network` would change the X111W and the RTL9607C engineering
# board too, and neither has been re-measured today. This is ADDITIVE: a board
# that is not named below is left byte-for-byte as it was.
#
# ★ THE ADDRESSES ARE EACH BOARD'S OWN DECLARED VALUE (`ONU_LAN_IP` in its
# `instrument/<SOC>/<BRAND>/<MODEL>/config.xml`), so the image and the test
# suite agree by construction rather than by coincidence.

board=""
[ -r /tmp/sysinfo/board_name ] && board=$(cat /tmp/sysinfo/board_name)

case "$board" in
hsgq,x111w)
	# bench onu2. Declared ONU_LAN_IP = 192.168.1.12.
	#
	# ★★★ THIS ENTRY WAS MISSING AND IT COST A NIGHT. This file was written
	# for the G24W and named only that board, so the X111W kept the shipped
	# 192.168.1.1 -- the address the X400AXF holds on bench `onu`. MEASURED
	# 2026-08-25, with the X111W freshly TFTP-booted on our image:
	#
	#     ping 192.168.1.1   -> answered, MAC 98:c7:a4:6c:af:cb  (X400AXF)
	#     ping 192.168.1.10  -> no reply, no ARP entry
	#
	# so `onu_lan_addr` -- the step whose whole job is to move this board off
	# the shipped address -- was talking to the OTHER BOARD, and the run
	# reported "the board did not answer 192.168.1.10 within 420s", which
	# reads like a dead device and is nothing of the kind.
	#
	# ⚠ AND IT IS ACTIVE HARM, not just a failed measurement: every cold boot
	# of this board put a SECOND host on a live bench's address and ARP-flapped
	# it. A boot-reliability run was cut mid-flight on 2026-08-25 for exactly
	# that reason.
	# ★ MOVED .10 -> .12 (operator, 2026-08-25): .2-.10 is the DHCP band in the
	#   lab address plan and .11-.20 is the ONU band.
	# ⚠ CORRECTED 2026-08-30: this line said "The G24W holds .11". It does not
	#   -- .11 is the X400AXF. The assignments are X111W .12 / G24W .13 /
	#   X400AXF .11, and this file's own `lanly,g24w` arm below sets .13. A
	#   wrong address in a comment inside the file that EXISTS to stop address
	#   confusion is the worst place for one.
	uci -q set network.lan.ipaddr='192.168.1.12'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.12 (.1 is BANNED and .10 is the DHCP band)"
	;;
lanly,g24w)
	# bench onu3. Declared ONU_LAN_IP = 192.168.1.13, and stock on this unit
	# answers telnet at the same address -- so the board keeps ONE identity
	# across both firmwares.
	uci -q set network.lan.ipaddr='192.168.1.13'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.13 (the shipped default 192.168.1.1 belongs to another bench)"
	;;
hsgq,x100dg)
	# bench onu6. Declared ONU_LAN_IP = 192.168.1.16, the address its stock
	# firmware holds too (persisted 2026-09-27).
	uci -q set network.lan.ipaddr='192.168.1.16'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.16"
	;;
vsol,v2801rgw)
	# bench onu5. Declared ONU_LAN_IP = 192.168.1.15, the address its stock
	# firmware holds too (persisted 2026-09-29).
	uci -q set network.lan.ipaddr='192.168.1.15'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.15"
	;;
unknown,rtl9607c-unknown)
	# bench onu4. Declared ONU_LAN_IP = 192.168.1.14. MEASURED 2026-09-29: with no
	# arm it kept the interaptiv file's 192.168.1.13 -- the G24W's address.
	uci -q set network.lan.ipaddr='192.168.1.14'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board -> lan 192.168.1.14"
	;;
"")
	# THREE STATES: we could not ask which board this is. Change NOTHING --
	# guessing here is how the wrong address gets applied to the wrong board,
	# which is the exact failure this file exists to prevent.
	logger -t luna-lan-addr "board_name unreadable -- LAN address left as shipped"
	;;
*)
	# A board with no entry takes NO LAN address: the shipped value is ANOTHER
	# board's (the interaptiv file holds the G24W's .13), and keeping it put a
	# second host on a live bench's address (2026-09-29, the RTL9607C UNKNOWN).
	# The console still reaches it; its declared address needs an arm above
	# (ONU-test-case/ip_plan_audit.py names every board that lacks one).
	uci -q delete network.lan.ipaddr
	uci -q delete network.lan.netmask
	uci -q set network.lan.proto='none'
	uci -q commit network
	logger -t luna-lan-addr "board_name=$board has no declared LAN address -- none taken"
	;;
esac

exit 0
