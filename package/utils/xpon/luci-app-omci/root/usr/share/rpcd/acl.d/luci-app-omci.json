{
	"luci-app-omci": {
		"description": "Grant access to the OMCI control plane",
		"read": {
			"ubus": {
				"omci.agent": [
					"family",
					"status",
					"config_list",
					"config_details",
					"config_get",
					"config_inspect",
					"class_list",
					"class_get",
					"mib_list",
					"mib_get",
					"status_live"
				],
				"omci.vlan": [
					"status"
				]
			},
			"uci": [
				"omci",
				"network"
			]
		},
		"write": {
			"ubus": {
				"omci.agent": [
					"agent_set",
					"config_set",
					"mib_set",
					"mib_delete",
					"mib_reset",
					"apply"
				]
			},
			"file": {
				"/usr/sbin/omci-vlanscan *": [
					"exec"
				]
			},
			"uci": [
				"omci"
			]
		}
	}
}
