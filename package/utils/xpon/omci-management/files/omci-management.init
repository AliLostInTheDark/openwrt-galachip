#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/omci-management
	procd_set_param term_timeout 10
	procd_set_param respawn
	procd_close_instance
}
reload_service() {
	stop
	start
}
service_triggers() {
	procd_add_reload_trigger network
}
