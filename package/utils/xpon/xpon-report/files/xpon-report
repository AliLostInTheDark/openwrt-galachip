#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Collect everything about the PON link into one file to send with a bug
# report: GPON or EPON state, PLOAM/OMCI/OAM, T-CONTs, GEM ports, services,
# switch flows, optics, packet engine, kernel log and settings.
# Serial numbers, passwords and LOIDs are masked unless -u is given.

usage() {
	cat <<-EOT
	usage: xpon-report [-o FILE|-] [-f] [-O] [-u]
	  -o FILE  write here (default /tmp/xpon-report-DATE.txt; - for stdout)
	  -f       also read full driver and packet engine snapshots
	  -O       compact OLT onboarding report (OLT-G, quirks, non-zero OMCI replies, MIB)
	  -u       do not mask serial numbers, passwords and LOIDs
	For the most detail, load the diagnostics module for your mode first
	and let the link come up (or fail) once:
	  modprobe gc1601-gpon-diag   (GPON)
	  modprobe gc1601-epon-diag   (EPON)
	The full dump (-f) reads hardware counters, which may clear on read.
	EOT
	exit 1
}

out="/tmp/xpon-report-$(date +%Y%m%d-%H%M%S).txt"
full=0
olt_only=0
unmasked=0
while getopts "o:fOuh" opt; do
	case "$opt" in
	o) out="$OPTARG" ;;
	f) full=1 ;;
	O) olt_only=1 ;;
	u) unmasked=1 ;;
	*) usage ;;
	esac
done

PONDBG=/sys/kernel/debug/gc1601-pon
XPON=/sys/class/xpon/pon0
ETH=/sys/kernel/debug/gc1601-eth
ETHDEV=
for d in /sys/bus/platform/devices/*.packet-engine/net/*; do
	[ -d "$d" ] && ETHDEV=${d##*/} && break
done
omci_status=$(ubus call xpon status 2>/dev/null)

section() {
	printf '\n===== %s =====\n' "$1"
}

show() {	# show FILE...: print each readable file with its name
	local f
	for f in "$@"; do
		[ -r "$f" ] || continue
		printf -- '--- %s\n' "$f"
		cat "$f" 2>&1
	done
}

run() {		# run CMD...: print the command and its output
	printf -- '--- %s\n' "$*"
	"$@" 2>&1
}

hex() {		# hex STRING: lower-case hex of each byte, without external tools
	local s=$1 c
	while [ -n "$s" ]; do
		c=${s%"${s#?}"}
		printf '%02x' "'$c"
		s=${s#?}
	done
}

spaced() {
	printf '%s' "$1" | sed 's/../& /g; s/ $//'
}

upper() {
	printf '%s' "$1" | tr 'abcdef' 'ABCDEF'
}

lower() {
	printf '%s' "$1" | tr 'ABCDEF' 'abcdef'
}

mask_line() {	# mask_line LITERAL: one sed command hiding it
	[ -n "$1" ] && printf 's/%s/[masked]/g\n' "$(escape "$1")"
}

escape() {
	printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g'
}

# sed program that hides every secret, in text and in hex (ploam_log etc.)
build_mask() {
	local s h v k vendorless
	{
		{
			for k in omci.main.password omci.main.loid omci.main.loid_password \
				epon.main.loid epon.main.loid_password omci.main.serial \
				cwmp.main.password cwmp.main.connection_request_password \
				cwmp.device.serial; do
				uci -q get "$k"
			done
			printf '%s\n' "$omci_status" | jsonfilter \
				-e '@.status.identity.serial' -e '@.status.identity.loid' 2>/dev/null
		} | while IFS= read -r s; do
			[ ${#s} -ge 4 ] || continue
			mask_line "$s"
			case "$s" in
			*[!0-9A-Fa-f]*) ;;
			*) mask_line "$(spaced "$s")" ;;
			esac
			h=$(hex "$s")
			for v in "$h" "$(upper "$h")"; do
				mask_line "$v"
				mask_line "$(spaced "$v")"
			done
			# GPON serial: vendor ID + 8 hex digits; the digits are the secret part
			vendorless=${s#????}
			if [ ${#s} -eq 12 ] && [ ${#vendorless} -eq 8 ]; then
				for v in "$(lower "$vendorless")" "$(upper "$vendorless")"; do
					mask_line "$v"
					mask_line "$(spaced "$v")"
				done
			fi
		done
		printf '%s\n' 's/\(serial[ _]number[ :=]*[A-Za-z][A-Za-z][A-Za-z][A-Za-z]\)[0-9A-Fa-f]\{8\}/\1[masked]/g'
		# any GPON serial, including other ONUs' in the PLOAM log
		printf '%s\n' 's/\(^\|[^A-Za-z0-9]\)\([A-Z]\{4\}\)[0-9A-F]\{8\}\($\|[^A-Za-z0-9]\)/\1\2[masked]\3/g'
		# key=value, key='value' and "key": "value"
		printf '%s\n' 's/\(sn=\)\([[:xdigit:]]\{2\} \)\{7\}[[:xdigit:]]\{2\}/\1[masked]/g'
		for k in serial serial_number serial-number sn loid LOID password Password loid_password; do
			printf '%s\n' "/\.serial: /!s/\($k['\"]\{0,1\}[=:] *['\"]\{0,1\}\)[^' ,}\"]\{1,\}/\1[masked]/g"
		done
	} > "$1"
}

collect() {
	section "System"
	run date
	run uptime
	show /etc/openwrt_release /proc/version
	run cat /tmp/sysinfo/model

	section "PON mode"
	show "$XPON/mode_current" "$XPON/mode_available" "$XPON/state" "$XPON/carrier"
	run uci -q get xpon.main.mode
	run lsmod
	show "$PONDBG/pon_status"
	run xponctl get
	[ -f /etc/xpon-rogue ] && echo "/etc/xpon-rogue present: transmitter held off"

	section "GPON"
	show "$PONDBG/gpon_state" "$PONDBG/gpon_events" \
	     "$PONDBG/gpon_ber" "$PONDBG/ploam_log" "$PONDBG/ploam_trace" "$PONDBG/pon_counters" \
	     "$PONDBG/tcont_stats"
	run ethtool -S pon0
	if [ "$full" = 1 ]; then run omci-report; else run omci-report -b; fi

	section "OMCI"
	printf -- '--- ubus call xpon status\n%s\n' "$omci_status"
	[ -n "$ETHDEV" ] && run ethtool -S "$ETHDEV"

	section "EPON"
	show "$PONDBG/epon_state" /var/run/epon-oamd.json
	[ -d /sys/kernel/debug/gc1601-epon ] && show /sys/kernel/debug/gc1601-epon/regs

	section "LAN VLAN and switch offload"
	run ubus call xpon vlan_status

	section "Packet engine"
	show "$ETH/diagnostics" "$ETH/rx" "$ETH/tx_config"
	if [ "$full" = 1 ]; then
		show "$ETH/queues" "$ETH/ingress"
	fi

	section "Network"
	run ip -s -d link show
	run ip addr show
	run bridge link show
	show /proc/net/dev

	section "Settings"
	run uci show xpon
	run uci show omci
	run uci show epon
	run uci show network

	section "Kernel log (PON)"
	dmesg | grep -iE 'pon|gpon|epon|omci|sfu|oam|xpon|gc1601|bosa|ploam|mpcp|llid' 2>&1

	section "Kernel log"
	dmesg
}

collect_olt() {
	section "OLT Onboarding Summary"
	show "$XPON/mode_current" "$XPON/state" "$XPON/carrier" \
		/tmp/omcid-olt-diag.txt /etc/omci/olt-profiles.conf
	run omcictl status
	run omcictl config list

	section "OLT-G and Core Datapath MEs"
	run omcictl mib show 131
	run omcictl mib show 262
	run omcictl mib show 268
	run omcictl mib show 171
	run omcictl mib list

	section "OMCI Activity"
	run omci-report -b
	run logread -e omcid
}

umask 077
mask=$(mktemp /tmp/.xpon-report-mask.XXXXXX) || exit 1
trap 'rm -f "$mask"' EXIT
trap 'exit 1' HUP INT TERM
[ "$unmasked" = 1 ] || build_mask "$mask"

run_collect() {
	if [ "$olt_only" = 1 ]; then
		collect_olt
	else
		collect
	fi
}

if [ "$out" = "-" ]; then
	run_collect | sed -f "$mask"
else
	run_collect | sed -f "$mask" > "$out"
	echo "Report written to $out"
	[ "$unmasked" = 1 ] || echo "Serial numbers, passwords and LOIDs are masked; check the file before sharing it."
	echo "Copy it off with WinSCP (SCP) or: scp -O root@192.168.1.1:$out ."
fi
