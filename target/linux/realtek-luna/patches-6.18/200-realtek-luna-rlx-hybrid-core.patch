Index: linux-6.18.31/arch/mips/include/asm/mipsregs.h
===================================================================
--- linux-6.18.31.orig/arch/mips/include/asm/mipsregs.h
+++ linux-6.18.31/arch/mips/include/asm/mipsregs.h
@@ -1837,8 +1837,37 @@ do {									\
 #define read_c0_contextconfig()		__read_32bit_c0_register($4, 1)
 #define write_c0_contextconfig(val)	__write_32bit_c0_register($4, 1, val)
 
+#ifdef CONFIG_CPU_R3K_TLB
+/*
+ * The RLX "Taroko" core has no architectural UserLocal register (CP0 $4,2).
+ * Its per-thread pointer lives in the Lexra coprocessor register $8, reached
+ * with the custom mflxc0/mtlxc0 instructions.  The assembler has no mnemonic
+ * for them, so they are emitted as .word; both encodings name GPR $3 as the
+ * transfer register.  Userspace reads the same register via mflxc0, so the
+ * kernel and C library agree on where the thread pointer lives.
+ */
+static inline unsigned long read_c0_userlocal(void)
+{
+	unsigned long val;
+
+	__asm__ __volatile__(
+		"	.word	0x40634000	\n"	/* mflxc0 $3, $8 */
+		"	move	%0, $3		\n"
+		: "=r" (val) : : "$3");
+	return val;
+}
+
+static inline void write_c0_userlocal(unsigned long val)
+{
+	__asm__ __volatile__(
+		"	move	$3, %0		\n"
+		"	.word	0x40e34000	\n"	/* mtlxc0 $3, $8 */
+		: : "r" (val) : "$3");
+}
+#else
 #define read_c0_userlocal()	__read_ulong_c0_register($4, 2)
 #define write_c0_userlocal(val) __write_ulong_c0_register($4, 2, val)
+#endif
 
 #define read_c0_xcontextconfig()	__read_ulong_c0_register($4, 3)
 #define write_c0_xcontextconfig(val)	__write_ulong_c0_register($4, 3, val)
