index 1e2201013..67c57ed40 100644
--- a/arch/arm/mm/Makefile
+++ b/arch/arm/mm/Makefile
@@ -54,6 +54,7 @@ obj-$(CONFIG_CPU_SA1100)	+= copypage-v4mc.o
 obj-$(CONFIG_CPU_XSCALE)	+= copypage-xscale.o
 obj-$(CONFIG_CPU_XSC3)		+= copypage-xsc3.o
 obj-$(CONFIG_CPU_COPY_FA)	+= copypage-fa.o
+obj-$(CONFIG_CPU_COPY_FA626TE) += copypage-fa626te.o
 
 obj-$(CONFIG_CPU_TLB_V4WT)	+= tlb-v4.o
 obj-$(CONFIG_CPU_TLB_V4WB)	+= tlb-v4wb.o
@@ -75,6 +76,7 @@ obj-$(CONFIG_CPU_ARM926T)	+= proc-arm926.o
 obj-$(CONFIG_CPU_ARM940T)	+= proc-arm940.o
 obj-$(CONFIG_CPU_ARM946E)	+= proc-arm946.o
 obj-$(CONFIG_CPU_FA526)		+= proc-fa526.o
+obj-$(CONFIG_CPU_FA626TE)		+= proc-fa626te.o
 obj-$(CONFIG_CPU_ARM1020)	+= proc-arm1020.o
 obj-$(CONFIG_CPU_ARM1020E)	+= proc-arm1020e.o
 obj-$(CONFIG_CPU_ARM1022)	+= proc-arm1022.o
diff --git a/arch/arm/mm/cache-fa.S b/arch/arm/mm/cache-fa.S
index e16417995..8a780e777 100644
--- a/arch/arm/mm/cache-fa.S
+++ b/arch/arm/mm/cache-fa.S
@@ -21,7 +21,11 @@
 /*
  * The size of one data cache line.
  */
+#ifdef CONFIG_CPU_FA626TE
+#define CACHE_DLINESIZE	32
+#else
 #define CACHE_DLINESIZE	16
+#endif
 
 /*
  * The total size of the data cache.
@@ -243,5 +247,8 @@ SYM_FUNC_END(fa_dma_map_area)
  *	- dir	- DMA direction
  */
 SYM_TYPED_FUNC_START(fa_dma_unmap_area)
+	add	r1, r1, r0
+	teq	r2, #DMA_TO_DEVICE
+	bne	fa_dma_inv_range
 	ret	lr
 SYM_FUNC_END(fa_dma_unmap_area)
diff --git a/arch/arm/mm/flush.c b/arch/arm/mm/flush.c
index 4d7ef5cc3..1ef64445d 100644
--- a/arch/arm/mm/flush.c
+++ b/arch/arm/mm/flush.c
@@ -38,15 +38,29 @@ EXPORT_SYMBOL(arm_heavy_mb);
 static void flush_pfn_alias(unsigned long pfn, unsigned long vaddr)
 {
 	unsigned long to = FLUSH_ALIAS_START + (CACHE_COLOUR(vaddr) << PAGE_SHIFT);
+#ifdef CONFIG_CPU_FA626TE
+	unsigned long end = to + PAGE_SIZE;
+#else
 	const int zero = 0;
+#endif
 
+	preempt_disable();
 	set_top_pte(to, pfn_pte(pfn, PAGE_KERNEL));
 
+#ifdef CONFIG_CPU_FA626TE
+	/* FA626TE has no MCRR range-cache operation. */
+	for (; to < end; to += 32)
+		asm volatile("mcr p15, 0, %0, c7, c14, 1"
+			     : : "r" (to) : "memory");
+	dsb();
+#else
 	asm(	"mcrr	p15, 0, %1, %0, c14\n"
 	"	mcr	p15, 0, %2, c7, c10, 4"
 	    :
 	    : "r" (to), "r" (to + PAGE_SIZE - 1), "r" (zero)
 	    : "cc");
+#endif
+	preempt_enable();
 }
 
 static void flush_icache_alias(unsigned long pfn, unsigned long vaddr, unsigned long len)
diff --git a/arch/arm/mm/proc.c b/arch/arm/mm/proc.c
index 2027845ef..cbb4ea8cf 100644
--- a/arch/arm/mm/proc.c
+++ b/arch/arm/mm/proc.c
@@ -201,6 +201,23 @@ void cpu_fa526_set_pte_ext(pte_t *ptep, pte_t pte, unsigned int ext);
 __ADDRESSABLE(cpu_fa526_set_pte_ext);
 #endif
 
+#ifdef CONFIG_CPU_FA626TE
+void cpu_fa626te_proc_init(void);
+__ADDRESSABLE(cpu_fa626te_proc_init);
+void cpu_fa626te_proc_fin(void);
+__ADDRESSABLE(cpu_fa626te_proc_fin);
+void cpu_fa626te_reset(unsigned long addr, bool hvc);
+__ADDRESSABLE(cpu_fa626te_reset);
+int cpu_fa626te_do_idle(void);
+__ADDRESSABLE(cpu_fa626te_do_idle);
+void cpu_fa626te_dcache_clean_area(void *addr, int size);
+__ADDRESSABLE(cpu_fa626te_dcache_clean_area);
+void cpu_fa626te_switch_mm(phys_addr_t pgd_phys, struct mm_struct *mm);
+__ADDRESSABLE(cpu_fa626te_switch_mm);
+void cpu_fa626te_set_pte_ext(pte_t *ptep, pte_t pte, unsigned int ext);
+__ADDRESSABLE(cpu_fa626te_set_pte_ext);
+#endif
+
 #ifdef CONFIG_CPU_ARM1020
 void cpu_arm1020_proc_init(void);
 __ADDRESSABLE(cpu_arm1020_proc_init);
