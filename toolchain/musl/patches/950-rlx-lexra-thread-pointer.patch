--- a/arch/mips/pthread_arch.h
+++ b/arch/mips/pthread_arch.h
@@ -1,10 +1,12 @@
 static inline uintptr_t __get_tp()
 {
 	register uintptr_t tp __asm__("$3");
-#if __mips_isa_rev < 2
-	__asm__ (".word 0x7c03e83b" : "=r" (tp) );
-#else
+#if __mips_isa_rev >= 2
+	/* Standard MIPS32r2+ (interAptiv): thread pointer in CP0 UserLocal. */
 	__asm__ ("rdhwr %0, $29" : "=r" (tp) );
+#else
+	/* RLX/Taroko (Lexra MIPS-I, no rdhwr): tp is in LXC0 $8, mflxc0 $3,$8. */
+	__asm__ (".word 0x40634000" : "=r" (tp) );
 #endif
 	return tp;
 }
