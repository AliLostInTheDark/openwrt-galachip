const MAX_EVENTS = 64;
const OBSERVE_EVERY = 5;
let observe_tick = 0;
let event_log = {};
let prev_obs = {};

function uptime_str() {
	let raw = readfile('/proc/uptime');
	let parts = raw ? split(trim(raw), /\s+/) : [];
	return parts[0] ? `${parts[0]}s` : '-';
}

function record_event(device, kind, message) {
	let list = event_log[`${device}`] || (event_log[`${device}`] = []);
	unshift(list, {
		time: time(),
		uptime: uptime_str(),
		kind: kind,
		message: message
	});
	if (length(list) > MAX_EVENTS)
		splice(list, MAX_EVENTS);
}

function observe_status(device, s) {
	if (!s)
		return;

	let key = `${device}`;
	let prev = prev_obs[key];
	let omci_alarms = s.alarms_text ? trim(s.alarms_text) : '';
	let cur = {
		state: s.state,
		onu_id: s.onu_id,
		channel_up: !!s.channel_up,
		agent_op: !!s.agent_operational,
		mib_sync: s.mib_sync,
		bosa_alarms: s.bosa_alarms || 0,
		omci_alarms: omci_alarms
	};

	if (!prev) {
		prev_obs[key] = cur;
		record_event(device, 'state',
			sprintf('Initial observation: O%s, ONU ID %s, OMCC %s, MIB sync %s',
				cur.state ?? '?', cur.onu_id ?? '-',
				cur.channel_up ? 'up' : 'down', cur.mib_sync ?? '-'));
		return;
	}

	if (cur.state != prev.state)
		record_event(device, 'ploam',
			sprintf('PON state changed: O%s -> O%s (ONU ID %s)',
				prev.state ?? '?', cur.state ?? '?', cur.onu_id ?? '-'));
	if (cur.channel_up != prev.channel_up)
		record_event(device, 'omcc',
			sprintf('OMCC channel %s (ONU ID %s)',
				cur.channel_up ? 'up' : 'down', cur.onu_id ?? '-'));
	if (cur.agent_op != prev.agent_op)
		record_event(device, 'agent',
			sprintf('OMCI agent %s', cur.agent_op ? 'operational' : 'not operational'));
	if (cur.mib_sync != prev.mib_sync)
		record_event(device, 'omci',
			sprintf('MIB data sync changed: %s -> %s (%s objects)',
				prev.mib_sync ?? '-', cur.mib_sync ?? '-', s.mib_objects ?? '-'));
	if (cur.bosa_alarms != prev.bosa_alarms)
		record_event(device, 'alarm',
			sprintf('BOSA alarm mask changed: 0x%03x -> 0x%03x',
				prev.bosa_alarms, cur.bosa_alarms));
	if (cur.omci_alarms != prev.omci_alarms)
		record_event(device, 'alarm',
			cur.omci_alarms ? `OMCI alarms: ${replace(cur.omci_alarms, /\n/g, '; ')}` : 'OMCI alarms cleared');

	prev_obs[key] = cur;
}

