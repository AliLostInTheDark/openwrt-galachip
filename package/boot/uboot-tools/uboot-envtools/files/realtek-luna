[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
vsol,v2802rh)
	ubootenv_add_mtd "env" "0x0" "0x2000" "0x1000"
	ubootenv_add_mtd "env2" "0x0" "0x2000" "0x1000"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
