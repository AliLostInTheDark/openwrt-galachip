config RTL8192FE
	tristate "Realtek RTL8192FE 802.11n PCIe Wireless Network Adapter"
	depends on PCI
	select RTLWIFI
	select RTLWIFI_PCI
	help
	  Clean-room mac80211 driver for the Realtek RTL8192F (RTL8192FE)
	  802.11n 2T2R PCIe Wi-Fi adapter (PCI 0x10ec:0x818c). Built as an
	  rtlwifi sub-driver; reuses the rtlwifi PCI core. See DESIGN.md.
