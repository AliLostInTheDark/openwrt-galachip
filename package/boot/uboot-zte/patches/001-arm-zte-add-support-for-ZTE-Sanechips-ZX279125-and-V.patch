+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZTE Sanechips ZX279125 Board Support
+ *
+ * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
+ */
+
+#include <config.h>
+#include <dm.h>
+#include <fdtdec.h>
+#include <init.h>
+#include <log.h>
+#include <zx279125-pp.h>
+#include <asm/io.h>
+
+#define ZX279125_RST_BASE	0x94000000
+#define ZX279125_RST_SOFT	0x3c
+
+int dram_init(void)
+{
+	gd->ram_size = 0x01000000; /* 16 MiB managed by U-Boot */
+	return 0;
+}
+
+int dram_init_banksize(void)
+{
+	gd->dram[0].start = 0x40000000;
+	gd->dram[0].size  = 0x01000000; /* 16 MiB bank 0 */
+	return 0;
+}
+
+int board_init(void)
+{
+	gd->bd->bi_boot_params = 0x40000100;
+	return 0;
+}
+
+int print_cpuinfo(void)
+{
+	printf("SoC:   ZTE Sanechips ZX279125 (ARMv7 Cortex-A9 @ 600 MHz)\n");
+	return 0;
+}
+
+void reset_cpu(void)
+{
+	unsigned int i;
+
+	/* DRAM survives this reset; a later monitor must not adopt a stale table. */
+	for (i = 0; i < ZX279125_PP_CURSORS_SIZE; i += 4)
+		writel(0, (void __iomem *)(ZX279125_PP_CURSORS + i));
+
+	writel(1, (void __iomem *)(ZX279125_RST_BASE + ZX279125_RST_SOFT));
+	while (1)
+		;
+}
