#!/bin/sh /etc/rc.common
# Per-board GPON ONU provisioning. Reads THIS unit's identity from the factory
# (apmib) config partition and applies it before the network starts, so one
# identical image self-provisions an entire fleet. Factory flash is read-only.
# SPDX-License-Identifier: GPL-2.0-or-later

START=09
USE_PROCD=1

RTK=/usr/sbin/rtk_factory
ENVFILE=/var/run/gpon.env
BOSA_CAL_DST=/lib/firmware/vsol/v2802rh-gn25l95.bin
BOSA_CAL_TYPE_DST=/lib/firmware/vsol/v2802rh-gn25l95-lan-type
GPON_SN_PARAM=/sys/module/luna_gpon/parameters/onu_sn
GPON_PWD_PARAM=/sys/module/luna_gpon/parameters/onu_password
KMSG=/dev/kmsg

. /lib/functions/gpon-cal.sh
. /lib/functions/onu-identity.sh

# logd starts after this START=09 script, so the kernel log keeps the boot-time lines.
log() {
	logger -t gpon_provision "$@"
	echo "gpon_provision: $*" >> "$KMSG" 2>/dev/null
}

# Every factory field from ONE rtk_factory read (the fields cost ~0.12 s each when
# asked one by one): RTK_<verb>, and RTK_HAS_<verb>=1 when the unit has the key,
# since an empty value is not an absent one (see set_password).
rtk_load() {
	local k v out
	for k in ${RTK_LOADED:-}; do unset "RTK_$k" "RTK_HAS_$k"; done
	RTK_LOADED=
	out=$("$RTK" -p "$1" all 2>/dev/null) ||
		log "factory read of '$1' failed (rc $?); a re-read says: $("$RTK" -p "$1" all 2>&1 >/dev/null)"
	while IFS='=' read -r k v; do
		case "$k" in ''|*[!a-z0-9_]*) continue ;; esac
		eval "RTK_$k=\$v; RTK_HAS_$k=1"
		RTK_LOADED="$RTK_LOADED $k"
	done <<EOF
$out
EOF
}

rtk_need() { [ -n "${RTK_LOADED:-}" ] || rtk_load "$1"; }

apply_mac() {
	local ifname="$1" mac="$2"
	[ -n "$mac" ] || return 1
	if [ ! -d "/sys/class/net/$ifname" ]; then
		log "iface $ifname absent; MAC $mac not applied yet"
		return 1
	fi
	# Idempotent: skip if already set.
	[ "$(cat /sys/class/net/$ifname/address 2>/dev/null)" = "$mac" ] && return 0
	# Set the MAC LIVE, without a down/up: eth0 is the SHARED GMAC that carries the
	# GPON upstream OMCI TX. Bringing it down tears down the GMAC rings and the
	# GPON-specific TX setup (done once at driver probe, not re-done on ndo_open),
	# permanently killing the US-OMCI path -> the OLT keeps issuing Deactivate /
	# "Laser out" and the ONU churns O5<->O1. The driver sets IFF_LIVE_ADDR_CHANGE
	# so a live address write just reprograms the RX-filter IDR (TX untouched).
	ip link set dev "$ifname" address "$mac" && log "set $ifname MAC $mac (live)"
}

provision() {
	local source part base mac oui sn loid loid_pw ploam vid

	config_load gpon
	config_get source identity source factory
	config_get part   storage  config_part config
	config_get base   storage  base_ifname eth0
	config_get mac    identity mac
	config_get oui    identity oui
	config_get sn     identity sn
	config_get loid    identity loid
	config_get loid_pw identity loid_passwd
	config_get ploam   identity ploam_passwd
	config_get vid     identity pon_vendor_id

	if [ -x "$RTK" ]; then
		rtk_load "$part"
		# manual: a value left empty keeps the factory one (cloning only the serial keeps the MAC).
		if [ "$source" = "factory" ]; then
			mac=${RTK_mac:-}
			oui=${RTK_oui:-}
			sn=${RTK_sn:-}
		else
			[ -n "$mac" ] || mac=${RTK_mac:-}
			[ -n "$oui" ] || oui=${RTK_oui:-}
			[ -n "$sn" ]  || sn=${RTK_sn:-}
		fi
		[ -n "$vid" ]     || vid=${RTK_vendor_id:-}
		# SW-block params: adopt the factory value only where the installer left UCI empty.
		[ -n "$loid" ]    || loid=${RTK_loid:-}
		[ -n "$loid_pw" ] || loid_pw=${RTK_loid_passwd:-}
		[ -n "$ploam" ]   || ploam=${RTK_ploam_passwd:-}
	fi

	mac=$(echo "$mac" | tr 'A-F' 'a-f')
	if [ -n "$mac" ] && ! unit_mac_valid "$mac"; then
		log "factory MAC '$mac' on '$part' is a placeholder or not unicast - not this unit's identity"
		mac=""
	fi
	if [ -z "$mac" ]; then
		# The driver may have taken the MAC from a mac= boot parameter.
		mac=$(cmdline_mac)
		if unit_mac_valid "$mac"; then
			log "no factory MAC on '$part' - using $mac from the mac= boot parameter; PROVISIONING MISSING on this unit"
		else
			mac=""
			# No identity from any source: none is invented (operator, 2026-10-01).
			log "NO factory MAC on '$part' and no mac= boot parameter - no MAC is invented; PROVISIONING MISSING on this unit"
		fi
	fi

	# Hand the GPON identity to the OMCI/GPON stack (Phase 1C consumer) FIRST,
	# before touching netifd/uci (which can be slow/incomplete at START=09) — the
	# env file is the authoritative per-board data and must always be written.
	umask 077
	mkdir -p "$(dirname "$ENVFILE")" 2>/dev/null
	{
		echo "GPON_MAC=$mac"
		echo "GPON_OUI=$oui"
		echo "GPON_SN=$sn"
		echo "GPON_LOID=$loid"
		echo "GPON_LOID_PASSWD=$loid_pw"
		echo "GPON_PLOAM_PASSWD=$ploam"
		echo "PON_VENDOR_ID=$vid"
	} > "$ENVFILE"

	log "provisioned: MAC=$mac SN=${sn:-?} (source=$source)"

	apply_mac "$base" "$mac"

	# netifd builds br-lan after this script and resets the bridge MAC to the
	# driver's: pin this unit's MAC on the bridge sections in UCI too.
	if [ -n "$mac" ] && [ -f /etc/config/network ]; then
		local sec
		for sec in $(uci -q show network 2>/dev/null | \
			     sed -n "s/^network\.\([^.=]*\)\.type='bridge'\$/\1/p"); do
			uci -q set "network.$sec.macaddr=$mac"
		done
		uci -q commit network 2>/dev/null
	fi
}

# The RTOS temperature correction selects one of two tables using LAN_TYPE.
stage_lan_type() {
	local tmp="$1" lan_type
	[ -n "${RTK_lan_type:-}" ] || return 1
	lan_type=$(printf '%d' "$RTK_lan_type") || return 1
	[ "$lan_type" -ge 0 ] && [ "$lan_type" -le 255 ] || return 1
	printf '%u\n' "$lan_type" > "$tmp/lan-type" || return 1
	gpon_cal_stage "$tmp/lan-type" "" "$BOSA_CAL_TYPE_DST" \
		"$(wc -c < "$tmp/lan-type")"
}

# GN25L95: the host calibrates the part from this unit's rtkbosa file. A failed
# stage must not leave older bytes available to request_firmware.
stage_gn_cal() {
	local part="$1" tmp why=
	tmp=$(mktemp -d /tmp/gpon-cal.XXXXXX) || return 1
	if ! stage_lan_type "$tmp" 2>"$tmp/err"; then
		why="missing or invalid factory LAN_TYPE, or staging failed"
	fi
	if [ -z "$why" ] && {
	   ! "$RTK" -p "$part" bosa_cal "$tmp/cal" 2>"$tmp/err" ||
	   ! gpon_cal_stage "$tmp/cal" "$tmp/cal.md5" "$BOSA_CAL_DST" 1024 2>>"$tmp/err"; }; then
		why=$(cat "$tmp/err")
		why=${why:-no reason given}
	fi
	rm -f "$tmp/cal" "$tmp/cal.new" "$tmp/cal.md5" "$tmp/cal.md5.new" "$tmp/err" "$tmp/lan-type" ||
		log "could not remove calibration candidate files in $tmp"
	rmdir "$tmp" || log "could not remove calibration candidate directory $tmp"
	[ -n "$why" ] || return 0
	rm -f "$BOSA_CAL_DST" || {
		log "cannot withdraw stale GN25L95 calibration; not activating GPON"
		return 1
	}
	rm -f "$BOSA_CAL_TYPE_DST" || return 1
	log "GN25L95 calibration unavailable ($why); GPON activation waits for it"
	return 1
}

# The PLOAM password stock sends: LuCI/UCI first, else this unit's factory MIB, where an
# EMPTY value is sent as ten zero octets as stock does; only a MIB without the key keeps
# the driver's default. Written before the serial, whose write
# starts ranging. The newline is what lets an empty value reach the driver at all.
set_password() {
	local pw p
	rtk_need "$1"
	pw=$(gpon_ploam_password "${RTK_HAS_ploam_passwd:+1}" "${RTK_ploam_passwd:-}") || {
		log "no PLOAM password in this unit's MIB - the driver keeps its default"
		return 0
	}
	[ -w "$GPON_PWD_PARAM" ] || return 0
	printf '%s\n' "$pw" > "$GPON_PWD_PARAM" && { log "PLOAM password handed to the driver"; return 0; }
	log "PLOAM password refused by the driver (0..10 printable characters)"
}

# The OMCI identity (onu-identity.sh omci_id_apply): LuCI/UCI first, else this
# unit's MIB, read once by rtk_factory. Refusals are logged, never fatal.
rtk_mib_value() { eval "printf '%s' \"\${RTK_$1:-}\""; }
set_omci_identity() {
	rtk_need "$1"
	omci_id_apply rtk_mib_value | while read -r msg; do log "$msg"; done
}

try_identity() {
	local part calpart sn

	config_load gpon
	config_get part storage config_part config
	# The VSOL RTOS boards keep the calibration in their "osk" partition.
	grep -qs '"osk"$' /proc/mtd && calpart=osk || calpart=$part
	config_get calpart storage cal_part "$calpart"
	rtk_load "$part"
	sn=$(gpon_serial "${RTK_sn:-}")
	[ -n "$sn" ] || { log "no GPON serial available; will retry"; return 1; }

	stage_gn_cal "$calpart" || return 1
	set_password "$part"
	set_omci_identity "$part"

	if [ ! -w "$GPON_SN_PARAM" ]; then
		log "GPON serial endpoint not ready; will retry"
		return 1
	fi
	if printf '%s' "$sn" > "$GPON_SN_PARAM"; then
		log "GPON serial accepted by driver"
		return 0
	fi
	log "GPON activation rejected; will retry"
	return 1
}

retry_identity() {
	local interval=5
	while :; do
		sleep "$interval"
		try_identity && return 0
		interval=$((interval * 2))
		[ "$interval" -le 300 ] || interval=300
	done
}

start_service() {
	provision
	try_identity && return 0
	procd_open_instance identity
	procd_set_param command /bin/sh /etc/init.d/gpon_provision --retry-identity
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# LuCI 'Save & Apply' (Phase 1E): procd calls reload_service when /etc/config/gpon
# changes -> re-provision live, no reboot.
reload_service() {
	restart || return $?
	if [ -x /etc/init.d/omci ]; then
		/etc/init.d/omci reload 2>/dev/null
	fi
}

service_triggers() {
	procd_add_reload_trigger "gpon"
}
# The worker bypasses rc.common: sourcing procd.sh would retain its service
# lock throughout retries and prevent stop/reload from acquiring that lock.
if [ "${1:-}" = --retry-identity ]; then
	. /lib/functions.sh
	retry_identity
fi
