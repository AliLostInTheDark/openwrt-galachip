#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

count=${1:-20}
case "$count" in
	''|*[!0-9]*) echo 'Usage: xpon-diagnostics [1..60 samples]' >&2; exit 2 ;;
esac
[ "$count" -ge 1 ] 2>/dev/null && [ "$count" -le 60 ] 2>/dev/null || exit 2

# Allowlisted snapshots only: no UCI, credentials, raw PLOAM/OAM or MMIO dumps.
pon=/sys/class/net/pon0/device
pe=/sys/bus/platform/devices/90e00000.packet-engine
show() {
	[ -r "$1" ] || return 0
	printf '\n[%s]\n' "$1"
	cat "$1"
}

printf 'xpon-diagnostics v1 samples=%s interval=1s\n' "$count"
show /proc/version
for p in /sys/module/omci/parameters/upstream_queue_tm \
	/sys/module/gc1601_eth/parameters/uni_omci_attrs \
	/sys/module/gc1601_eth/parameters/gem_sfu_shaping \
	/sys/module/gc1601_eth/parameters/sfu_queue_zero; do
	show "$p"
done
for p in "$pon"/sfu_offload "$pon"/sfu_vlan_map "$pon"/sfu_untag_vlan \
	"$pe"/sfu_snapshot "$pe"/tx_config "$pe"/gem_shapers; do
	show "$p"
done

n=0
while [ "$n" -lt "$count" ]; do
	printf '\n[sample %s]\n' "$n"
	show /proc/uptime
	show /proc/stat
	show /proc/net/dev
	show /proc/net/snmp
	show /proc/net/netstat
	show /proc/net/softnet_stat
	show /proc/interrupts
	for p in "$pon"/status "$pon"/gpon_state "$pon"/gpon_events \
		"$pon"/epon_state "$pon"/epon_counters "$pon"/epon_offload_status \
		"$pe"/diagnostics "$pe"/rx_snapshot; do
		show "$p"
	done
	if command -v jsonfilter >/dev/null 2>&1 && [ -r /var/run/epon-oamd.json ]; then
		printf '\n[epon-oamd diagnostic fields]\n'
		jsonfilter -i /var/run/epon-oamd.json \
			-e 'oam=@.oam' -e 'ctc=@.ctc' -e 'auth=@.auth' \
			-e 'acked_unapplied=@.acked_unapplied' -e 'unknown_leaves=@.unknown_leaves' \
			-e 'unknown_ouis=@.unknown_ouis' -e 'unknown_opcodes=@.unknown_opcodes' \
			-e 'last_unknown_oui=@.last_unknown_oui' -e 'last_unknown_opcode=@.last_unknown_opcode' \
			-e 'last_unknown_branch=@.last_unknown_branch' -e 'last_unknown_leaf=@.last_unknown_leaf'
	fi
	n=$((n + 1))
	[ "$n" -ge "$count" ] || sleep 1
done
printf '\n[end]\n'
