/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "gc1601.dtsi"

/ {
	model = "TP-Link XZ000-G7";
	compatible = "tplink,xz000-g7", "galachip,gc1601";

	aliases {
		serial0 = &uart0;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x02000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* The loader leaves these DMA pointers installed when Linux starts. */
		loader_dma: dma@40800000 {
			reg = <0x40800000 0x00112000>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_lan: led-lan {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_pon: led-pon {
			label = "green:pon";
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_los: led-los {
			label = "red:los";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&gpio {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&mdio {
	status = "okay";

	phy24: ethernet-phy@18 {
		reg = <0x18>;
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x020000>;
				read-only;
			};

			partition@20000 {
				compatible = "galachip,gc1601-fw";
				label = "firmware";
				reg = <0x020000 0x3b0000>;
			};

			partition@3d0000 {
				compatible = "nvmem-cells";
				label = "misc";
				reg = <0x3d0000 0x020000>;
				read-only;
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_misc: macaddr@1f100 {
					reg = <0x1f100 0x6>;
				};
			};

			partition@3f0000 {
				label = "hwconfig";
				reg = <0x3f0000 0x010000>;
				read-only;
			};
		};
	};
};

&packet_engine {
	phy-handle = <&phy24>;
	phy-mode = "sgmii";
	nvmem-cells = <&macaddr_misc>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&i2c0 {
	clock-frequency = <100000>;
	status = "okay";

	/* BOSA controller (UX3320S), SFF-8472 style A0/A2 pages. Read-only. */
	eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		read-only;
	};

	eeprom@51 {
		compatible = "atmel,24c02";
		reg = <0x51>;
		read-only;
	};
};

&pon {
	galachip,bosa-i2c = <&i2c0>;
	/*
	 * Bring the PON up at boot like the stock rcS: SerDes, BOSA tables from
	 * hwconfig (lost on every power cycle), GPON MAC receive-only. The laser
	 * stays off until allow_tx; the first ranging also waits for omci-agent
	 * to apply the UCI identity.
	 */
	galachip,pon-bringup;
	galachip,gpon-autostart;
	galachip,gpon-identity-wait-ms = <30000>;
	/*
	 * Stock identity from the misc config (X_TP_OmciCapability, DeviceInfo).
	 * Default serial: vendor + factory MAC; omci-agent sets the ISP one.
	 */
	omci-vendor-id = "TPLG";
	omci-equipment-id = "XZ000-G7";
	omci-version = "XZ000-G7 v1.0";
	omci-onu-type = /bits/ 8 <1>;	/* SFU */
	omci-uni-ports = <&packet_engine>;
	nvmem-cells = <&macaddr_misc>;
	nvmem-cell-names = "mac-address";

	leds = <&led_pon>, <&led_los>;
	led-names = "pon", "los";
	status = "okay";
};
