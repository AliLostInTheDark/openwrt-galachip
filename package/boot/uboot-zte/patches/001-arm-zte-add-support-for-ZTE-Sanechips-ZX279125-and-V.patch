diff --git a/drivers/timer/zx279125_timer.c b/drivers/timer/zx279125_timer.c
new file mode 100644
index 00000000..54a9743d
--- /dev/null
+++ b/drivers/timer/zx279125_timer.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * ZTE Sanechips ZX279125 Timer Driver
+ *
+ * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
+ */
+
+#include <dm.h>
+#include <timer.h>
+#include <asm/io.h>
+
+#define ZX_TIMER_MODE		0x04
+#define ZX_TIMER_RELOAD		0x08
+#define ZX_TIMER_ENABLE		0x0c
+#define ZX_TIMER_LATCH		0x10
+#define ZX_TIMER_COUNT		0x18
+
+#define ZX_TIMER_PERIODIC	2
+
+struct zx279125_timer_priv {
+	void __iomem *base;
+};
+
+static u64 zx279125_timer_get_count(struct udevice *dev)
+{
+	struct zx279125_timer_priv *priv = dev_get_priv(dev);
+
+	/* Down-counting hardware timer: invert for monotonically increasing count */
+	return timer_conv_64(~readl(priv->base + ZX_TIMER_COUNT));
+}
+
+static int zx279125_timer_probe(struct udevice *dev)
+{
+	struct timer_dev_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct zx279125_timer_priv *priv = dev_get_priv(dev);
+	u32 val;
+
+	priv->base = dev_read_addr_ptr(dev);
+	if (!priv->base)
+		return -EINVAL;
+
+	if (!uc_priv->clock_rate)
+		uc_priv->clock_rate = 25000000;
+
+	/* Stop timer */
+	writel(0, priv->base + ZX_TIMER_ENABLE);
+
+	/* Start periodic free-running timer with 0xffffffff reload */
+	writel(0xffffffff, priv->base + ZX_TIMER_RELOAD);
+	writel(ZX_TIMER_PERIODIC, priv->base + ZX_TIMER_MODE);
+	val = readl(priv->base + ZX_TIMER_LATCH);
+	writel(val ^ 0x0f, priv->base + ZX_TIMER_LATCH);
+	writel(1, priv->base + ZX_TIMER_ENABLE);
+
+	return 0;
+}
+
+static const struct timer_ops zx279125_timer_ops = {
+	.get_count = zx279125_timer_get_count,
+};
+
+static const struct udevice_id zx279125_timer_ids[] = {
+	{ .compatible = "zte,zx279125-timer" },
+	{}
+};
+
+U_BOOT_DRIVER(zx279125_timer) = {
+	.name = "zx279125_timer",
+	.id = UCLASS_TIMER,
+	.of_match = zx279125_timer_ids,
+	.priv_auto = sizeof(struct zx279125_timer_priv),
+	.probe = zx279125_timer_probe,
+	.ops = &zx279125_timer_ops,
+	.flags = DM_FLAG_PRE_RELOC,
+};
