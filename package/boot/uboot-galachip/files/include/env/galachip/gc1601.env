/* SPDX-License-Identifier: GPL-2.0-or-later */
/*
 * Default environment common to GalaChip GC1601 devices
 *
 * The board's .env includes it and names its files: bootfile (initramfs zImage), bootfile_upg
 * (sysupgrade image), bootfile_uboot (u-boot-with-spl.bin), bootfile_backup
 * (the whole flash, uploaded), and for stock firmware bootfile_stock and
 * bootargs_stock. misc_init_r() sets fw_offset, fw_size and flash_size from
 * the device tree and the flash.
 *
 * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
 */

ipaddr=192.168.1.1
serverip=192.168.1.10
loadaddr=0x41000000
autoload=no
autostart=no

/* run stops at the first command that fails. */
bootcmd=run boot_flash
boot_flash=run load_flash boot_kernel
boot_tftp=run load_tftp find_dtb boot_kernel
backup_flash=run read_flash put_flash
upgrade_tftp=run load_upgrade check_tag check_size write_firmware
restore_stock=run load_stock check_tag check_stock write_firmware verify_firmware
upgrade_uboot=run load_uboot check_uboot write_uboot verify_uboot

load_flash=fwload ${loadaddr}
load_tftp=tftpboot ${loadaddr} ${bootfile}
find_dtb=zdtb ${loadaddr}
boot_kernel=bootz ${loadaddr} - ${fdt_addr}
read_flash=sf probe; sf read ${loadaddr} 0 ${flash_size}
put_flash=tftpput ${loadaddr} ${flash_size} ${bootfile_backup}

/* sysupgrade.bin starts with the firmware tag and must fit the partition. */
load_upgrade=tftpboot ${loadaddr} ${bootfile_upg}
check_tag=itest.l *${loadaddr} == 0x03000003
check_size=itest ${filesize} <= ${fw_size}
write_firmware=sf probe; sf update ${loadaddr} ${fw_offset} ${filesize}
verify_firmware=sf read 0x41400000 ${fw_offset} ${filesize}; cmp.b ${loadaddr} 0x41400000 ${filesize}

/* This unit's raw backup of the whole firmware partition */
load_stock=tftpboot ${loadaddr} ${bootfile_stock}
check_stock=itest ${filesize} == ${fw_size}

/*
 * The whole boot region (0x0-0x20000): TPL, SPL and proper, checked as the
 * mask ROM and the loaders check them. sf update only rewrites 4 KiB blocks
 * that differ; a broken TPL recovers over the mask ROM's UART menu.
 */
load_uboot=tftpboot ${loadaddr} ${bootfile_uboot}
check_uboot=itest ${filesize} == 0x20000; ubcheck ${loadaddr} ${filesize}
write_uboot=sf probe; sf update ${loadaddr} 0 0x20000
verify_uboot=sf read 0x41200000 0 0x20000; cmp.b ${loadaddr} 0x41200000 0x20000
