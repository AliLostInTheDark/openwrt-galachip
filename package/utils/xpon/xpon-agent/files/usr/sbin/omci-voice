#!/usr/bin/ucode -S
// SPDX-License-Identifier: GPL-2.0-only
/*
 * Apply the OLT's OMCI voice provisioning to uvoice and report the line state
 * back into the MIB. Only ports the OLT provisioned are touched, and only the
 * options it set; omci.main.voice_provisioning 0 keeps the local voice
 * configuration and still reports the line state.
 */

import * as ubus from 'ubus';
import * as uloop from 'uloop';
import { cursor } from 'uci';
import { syslog, openlog, LOG_INFO, LOG_WARNING, LOG_DAEMON } from 'log';
import { CLASS, provisioning, reports } from 'omci.voice';

const POLL_MS = 5000;
/* Only the voice MEs: the whole MIB is hundreds of netlink round trips. */
const VOICE_CLASSES = sort(values(CLASS));
const SECRET = { sip_secret: true };

let bus, applied = null, last_reports = {};

function log(level, fmt, ...args) {
	syslog(level, sprintf(fmt, ...args));
}

function enabled() {
	let uci = cursor();

	return uci.get('omci', 'main', 'voice_provisioning') != '0';
}

/* The voip channel section of uvoice line N (option id N). */
function channel_section(uci, line) {
	let name = null;

	uci.foreach('voip', 'channel', s => {
		if (+s.id == line)
			name = s['.name'];
	});
	return name;
}

/* Reorder the configured codecs the OLT named; one uvoice lacks stays out. */
function apply_codecs(uci, list) {
	let prio = 1;

	for (let c in list)
		if (uci.get('voip', c) == 'codec')
			uci.set('voip', c, 'priority', `${prio++}`);
	uci.foreach('voip', 'codec', s => {
		if (!(s['.name'] in list))
			uci.set('voip', s['.name'], 'priority', `${prio++}`);
	});
}

function apply(ports) {
	let uci = cursor(), changed = [];

	for (let n, p in ports) {
		let section = channel_section(uci, +n - 1);

		if (!section) {
			section = `channel${n}`;
			uci.set('voip', section, 'channel');
			uci.set('voip', section, 'id', `${+n - 1}`);
		}
		for (let key, value in p) {
			if (value == null || key in ['codecs', 'transport', 'sip_agent'])
				continue;
			if (uci.get('voip', section, key) != `${value}`) {
				uci.set('voip', section, key, `${value}`);
				push(changed, SECRET[key] ? `${key}=<set>` : `${key}=${value}`);
			}
		}
		if (p.transport && uci.get('voip', 'base', 'transport') != p.transport) {
			uci.set('voip', 'base', 'transport', p.transport);
			push(changed, `transport=${p.transport}`);
		}
		if (length(p.codecs ?? [])) {
			apply_codecs(uci, p.codecs);
			push(changed, `codecs=${join(',', p.codecs)}`);
		}
	}
	if (!length(changed))
		return true;
	uci.commit('voip');
	log(LOG_INFO, 'OLT voice provisioning applied: %s', join(' ', changed));
	bus.call('voice', 'reload', {});
	return true;
}

function report(list) {
	for (let r in list) {
		let key = `${r.class_id}/${r.entity_id}`;

		if (last_reports[key] == r.data)
			continue;
		if (bus.call('xpon', 'mib_report', r) != null)
			last_reports[key] = r.data;
	}
}

function poll() {
	let mib = bus.call('xpon', 'mib_list', { classes: VOICE_CLASSES });
	let ports = provisioning(mib?.objects ?? []);
	let key = sprintf('%J', ports);

	if (length(ports) && key != applied && enabled()) {
		if (apply(ports))
			applied = key;
	} else if (!length(ports)) {
		applied = null;
	}
	report(reports(bus.call('voice', 'status', {}), ports, applied != null));
	uloop.timer(POLL_MS, poll);
}

openlog('omci-voice', 0, LOG_DAEMON);
uloop.init();
bus = ubus.connect();
if (!bus) {
	log(LOG_WARNING, 'cannot connect to ubus');
	exit(1);
}
poll();
uloop.run();
