'use strict';

/*
 * GC1601 rpcd backend for Linux xPON OMCI.
 *
 * There is intentionally no process execution in this file. Every kernel
 * operation goes through the native ucode module installed as omci.so.
 */

import * as omci from 'omci';
import { decode as decode_fields } from 'omci.mib';
import { connect } from 'ubus';
import { cursor } from 'uci';
import { interval } from 'uloop';
import { access, readfile, writefile } from 'fs';

const uci = cursor();
const event_bus = connect();
const DEVICE_DEFAULT = 0;
const CONFIG_POLL_MS = 2000;
const CONFIG_RETRY_POLLS = 15;
const XPON_SYSFS = '/sys/class/xpon/pon0';
const PON_SYSFS = '/sys/class/net/pon0/device';

let auto_apply_busy = false;
let last_applied_signature = null;
let last_config_signature = null;
let retry_polls = 0;

const config_specs = [
	{ key: 1,  name: 'serial', option: 'serial', scalar: false },
	{ key: 2,  name: 'vendor-id', option: 'vendor_id', scalar: false },
	{ key: 3,  name: 'version', option: 'version', scalar: false, legacy: true },
	{ key: 4,  name: 'equipment-id', option: 'equipment_id', scalar: false },
	{ key: 5,  name: 'password', option: 'password', scalar: false, secret: true },
	{ key: 6,  name: 'traffic-management-option', option: 'traffic_management_option', scalar: true },
	{ key: 7,  name: 'onu-type', option: 'onu_type', scalar: true },
	{ key: 8,  name: 'uni-count', option: 'uni_count', scalar: true },
	{ key: 9,  name: 'agent-enabled', option: 'enabled', scalar: true },
	{ key: 10, name: 'agent-permissive', option: 'permissive', scalar: true },
	{ key: 11, name: 'agent-fake-omci', option: 'fake_omci', scalar: true },
	{ key: 12, name: 'olt-profile', option: 'olt_profile', scalar: true },
	{ key: 13, name: 'olt-profile-force', option: 'olt_profile_force', scalar: true },
	{ key: 15, name: 'omcc-version', option: 'omcc_version', scalar: true },
	{ key: 16, name: 'hardware-version', option: 'hardware_version', scalar: false },
	{ key: 17, name: 'software-version-0', option: 'software_version_0', scalar: false },
	{ key: 18, name: 'software-version-1', option: 'software_version_1', scalar: false },
	{ key: 19, name: 'agent-reboot', option: 'reboot', scalar: true },
	{ key: 20, name: 'loid', option: 'loid', scalar: false },
	{ key: 21, name: 'loid-password', option: 'loid_password', scalar: false, secret: true },
	{ key: 22, name: 'dba-status-reporting', option: 'dba_status_reporting', scalar: true },
];

const profile_values = {
	unspecified: 0,
	none: 0,
	generic: 1,
	auto: 2,
	'nokia-alcl': 3,
	nokia: 3,
	alcl: 3,
	dasan: 4,
	huawei: 5,
	fiberhome: 6,
	zte: 7,
};

const profile_names = [
	'unspecified', 'generic', 'auto', 'nokia-alcl', 'dasan', 'huawei',
	'fiberhome', 'zte'
];

const source_names = [
	'unspecified', 'default', 'device-tree', 'nvmem', 'driver', 'netlink', 'sysfs'
];

const onu_type_names = [ 'other', 'sfu', 'hgu', 'mdu', 'sbu', 'mtu', 'cbu' ];

const category_names = [
	'unspecified', 'equipment', 'ani', 'uni', 'layer2', 'layer3',
	'multicast', 'voice', 'security', 'management', 'performance', 'xdsl',
	'legacy', 'vendor', 'reserved', 'other'
];

const support_names = [ 'catalog', 'shadow', 'parsed', 'provisioned', 'native' ];
const origin_names = [ 'default', 'local', 'olt', 'hardware' ];

const quirk_bits = [
	[ 1 << 0, 'allow-set-create' ],
	[ 1 << 1, 'fake-unsupported-success' ],
	[ 1 << 2, 'ignore-unsupported-uni' ],
	[ 1 << 3, 'full-uni-entity-id' ],
	[ 1 << 4, 'sanitize-version' ],
	[ 1 << 5, 'zte-vlan-tag-mode' ],
	[ 1 << 6, 'vendor-specific-mes' ],
	[ 1 << 7, 'dasan-multicast-ani' ],
];

const class_flag_bits = [
	[ 1 << 0, 'standard' ],
	[ 1 << 1, 'deprecated' ],
	[ 1 << 2, 'reserved' ],
	[ 1 << 3, 'vendor-specific' ],
	[ 1 << 4, 'performance' ],
	[ 1 << 5, 'table' ],
	[ 1 << 6, 'datapath' ],
];

/* Profiles are data, not executable scripts. */
const profiles = [
	{
		id: 'vivo-sp1-mitrastar-gpt2741gnac-n1',
		name: 'Vivo SP1 - Mitrastar GPT-2741GNAC-N1',
		description: 'Vivo São Paulo capital profile using the MitraStar identity.',
		inputs: [
			{ name: 'serial', label: 'GPON SN', required: true },
			{ name: 'password', label: 'SLID / GPON password', required: true }
		],
		values: {
			enabled: '1', permissive: '1', fake_omci: '0',
			vendor_id: 'MSTC', equipment_id: 'GPT-2741GNAC-N1-SV',
			olt_profile: 'nokia-alcl', olt_profile_force: 'nokia-alcl'
		}
	},
	{
		id: 'vivo2-askey-rtf8225vw',
		name: 'Vivo 2 - Askey RTF8225VW',
		description: 'TLCM/RTF8225VW identity. Vivo 2 does not require a SLID.',
		inputs: [
			{ name: 'serial', label: 'GPON SN', required: true }
		],
		values: {
			enabled: '1', permissive: '1', fake_omci: '0',
			vendor_id: 'TLCM', hardware_version: 'RTF8225VW',
			software_version_0: 'R8225VWTEF004',
			software_version_1: 'P8225VWTEF004',
			equipment_id: 'RTF8225VW-SV', password: '00000000000000000000',
			traffic_management_option: '2', omcc_version: '161',
			olt_profile: 'nokia-alcl', olt_profile_force: 'nokia-alcl'
		}
	}
];

function device_arg(request) {
	let d = request?.args?.device;
	return d == null ? DEVICE_DEFAULT : d;
}

function native_error(request, operation) {
	return reply_native_error(request, native_failure(operation));
}

function native_failure(operation) {
	let error = omci.error();

	return {
		success: false,
		error: error?.message || 'OMCI native binding failed',
		errno: error?.errno || 0,
		operation: operation
	};
}

function reply_native_error(request, failure) {
	let status = (failure.errno == 22 || failure.errno == 34) ?
		UBUS_STATUS_INVALID_ARGUMENT : UBUS_STATUS_UNKNOWN_ERROR;

	request.reply(failure, status);
	return null;
}

function profile_value(value) {
	if (value == null || `${value}` == '')
		return null;
	if (profile_values[`${value}`] != null)
		return profile_values[`${value}`];
	return value;
}

function profile_name(value) {
	return profile_names[value] || `unknown-${value}`;
}

function bits_to_names(value, table) {
	let out = [];
	value = value || 0;
	for (let item in table)
		if (value & item[0])
			push(out, item[1]);
	return out;
}

function find_spec_by_key(key) {
	for (let spec in config_specs)
		if (spec.key == key)
			return spec;
	return null;
}

function find_spec_by_name(name) {
	for (let spec in config_specs)
		if (spec.name == name || spec.option == name)
			return spec;
	return null;
}

function config_array_to_object(items) {
	let out = {};
	for (let item in (items || [])) {
		let spec = find_spec_by_key(item.key);
		if (spec)
			out[spec.name] = item.value;
	}
	return out;
}

function decorate_config_item(item) {
	let spec = find_spec_by_key(item.key);
	if (!spec)
		return item;
	item.name = spec.name;
	item.option = spec.option;
	item.scalar = spec.scalar;
	item.secret = spec.secret || false;
	item.source_name = source_names[item.source] || `unknown-${item.source}`;
	if (spec.name == 'olt-profile' || spec.name == 'olt-profile-force')
		item.profile_name = profile_name(item.value);
	return item;
}

function decorate_class(item) {
	item.category_name = category_names[item.category] || `unknown-${item.category}`;
	item.support_name = support_names[item.support] || `unknown-${item.support}`;
	item.flag_names = bits_to_names(item.flags, class_flag_bits);
	return item;
}

function decorate_mib(item) {
	item.origin_name = origin_names[item.origin] || `unknown-${item.origin}`;
	item.fields = decode_fields(item);
	return item;
}

function load_config(device) {
	let list = omci.config_list(device);
	if (list == null)
		return null;
	let out = {};
	for (let item in list) {
		decorate_config_item(item);
		out[item.name] = item.value;
	}
	return out;
}

const credentials_names = [
	'initial', 'successful', 'LOID error', 'password error', 'duplicate LOID'
];

function decorate_status(device, status, live) {
	status.onu_type_name = onu_type_names[status.onu_type] || `unknown-${status.onu_type}`;
	status.olt_profile_configured_name = profile_name(status.olt_profile_configured);
	status.olt_profile_effective_name = profile_name(status.olt_profile_effective);
	status.olt_profile_forced_name = profile_name(status.olt_profile_forced);
	status.olt_profile_quirk_names = bits_to_names(status.olt_profile_quirks, quirk_bits);

	/* Page refreshes do not need identity configuration or OLT-G lookups. */
	let config = live ? null : load_config(device);
	if (config != null) {
		status.reboot = config['agent-reboot'];
		status.traffic_management_option = config['traffic-management-option'];
		status.uni_count = config['uni-count'];
		status.serial = config.serial;
		status.vendor_id = config['vendor-id'];
		status.hardware_version = config['hardware-version'];
		status.software_version_0 = config['software-version-0'];
		status.software_version_1 = config['software-version-1'];
		status.equipment_id = config['equipment-id'];
		status.omcc_version = config['omcc-version'];
		status.identity = {
			serial: status.serial,
			'vendor-id': status.vendor_id,
			'hardware-version': status.hardware_version,
			'software-version-0': status.software_version_0,
			'software-version-1': status.software_version_1,
			'equipment-id': status.equipment_id,
			'omcc-version': status.omcc_version
		};
	}

	/* ONU-G credentials status the OLT last wrote for the LOID (G.988) */
	let loid_status = status.loid_status;
	if (type(loid_status) == 'int') {
		status.loid_status = loid_status;
		status.loid_status_name = credentials_names[loid_status] ?? `unknown-${loid_status}`;
	}

	/* ANI-G and PPTP Ethernet UNI alarms omcid reports to the OLT */
	let alarms = status.alarms_text;
	delete status.alarms_text;
	if (alarms != null) {
		status.omci_alarms = [];
		for (let line in split(trim(alarms), '\n')) {
			let f = split(line, ' ');
			if (length(f) == 4)
				push(status.omci_alarms, {
					class: int(f[0]),
					entity: f[1],
					reported: f[2] == 'reported',
					alarms: split(f[3], ',')
				});
		}
	}

	/* OLT-G is class 131, entity 0. Its absence is not a status failure. */
	let olt = live ? null : omci.mib_get(device, 131, 0);
	if (olt != null && olt.olt_g != null)
		status.olt = olt.olt_g;

	return status;
}

function uci_main(fresh) {
	if (fresh)
		uci.unload('omci');
	return uci.get_all('omci', 'main') || {};
}

function device_from_section(section) {
	let device = int(section.device || '0', 0);

	if (device == null || device < 0 || device > 0xffffffff)
		return DEVICE_DEFAULT;

	return device;
}

function config_signature(section) {
	let values = [
		`device=${section.device ?? ''}`,
		`reset_mib=${section.reset_mib ?? ''}`
	];

	for (let spec in config_specs)
		push(values, `${spec.option}=${section[spec.option] ?? ''}`);

	return join('\x1f', values);
}

function set_uci_options(values) {
	for (let spec in config_specs) {
		let value = values[spec.option];
		if (value != null)
			uci.set('omci', 'main', spec.option, `${value}`);
	}
	uci.commit('omci');
}

function apply_uci_section(section, device) {
	let applied = [];

	/* Legacy combined version first; explicit versions intentionally win. */
	let ordered = [];
	for (let spec in config_specs)
		if (spec.legacy)
			push(ordered, spec);
	for (let spec in config_specs)
		if (!spec.legacy)
			push(ordered, spec);

	for (let spec in ordered) {
		let value = section[spec.option];
		if (value == null || `${value}` == '')
			continue;
		if (spec.name == 'olt-profile' || spec.name == 'olt-profile-force')
			value = profile_value(value);
		if (omci.config_set(device, spec.key, value) == null)
			return native_failure(`apply ${spec.name}`);
		push(applied, spec.name);
	}

	if (`${section.reset_mib || '0'}` == '1') {
		if (omci.mib_reset(device) == null)
			return native_failure('apply MIB reset');
		uci.set('omci', 'main', 'reset_mib', '0');
		uci.commit('omci');
		section.reset_mib = '0';
		push(applied, 'mib-reset');
	}

	return { success: true, device: device, applied: applied };
}

function refresh_applied_signature(success) {
	let section = uci_main(true);
	let signature = config_signature(section);

	last_config_signature = signature;
	if (success)
		last_applied_signature = signature;

	return signature;
}

function apply_uci_values(request, device) {
	let section = uci_main(true);
	let result = apply_uci_section(section, device);

	/* A debug apply to a device other than the configured one must not suppress
	 * the automatic apply for the device selected in UCI. */
	refresh_applied_signature(result.success && device == device_from_section(section));
	if (!result.success)
		return reply_native_error(request, result);

	return result;
}

function auto_apply(trigger) {
	if (auto_apply_busy)
		return;

	let section = uci_main(true);
	let signature = config_signature(section);

	if (signature == last_applied_signature) {
		last_config_signature = signature;
		retry_polls = 0;
		return;
	}

	/* A failed signature is retried every 30 seconds, or immediately on a
	 * fresh config.change event. This avoids a tight log loop if net/omci is
	 * temporarily unavailable while still recovering without another commit. */
	if (trigger == 'poll' && signature == last_config_signature &&
	    ++retry_polls < CONFIG_RETRY_POLLS)
		return;

	last_config_signature = signature;
	retry_polls = 0;
	auto_apply_busy = true;

	let result = apply_uci_section(section, device_from_section(section));
	refresh_applied_signature(result.success);
	auto_apply_busy = false;

	if (!result.success)
		warn(`omci.agent: automatic UCI apply failed during ${trigger}: ` +
		     `${result.operation}: ${result.error}\n`);
}

function config_change(type, data) {
	let package_name = data?.config || data?.package || data?.data?.config || data?.data?.package;

	if (type == 'config.change' && package_name == 'omci')
		auto_apply('config.change');
}

function profile_by_id(id) {
	for (let p in profiles)
		if (p.id == id)
			return p;
	return null;
}

const methods = {
	family: {
		call: function(request) {
			let data = omci.family();
			if (data == null)
				return native_error(request, 'family');
			return { family: data };
		}
	},

	status: {
		args: { device: 0 },
		call: function(request) {
			let device = device_arg(request);
			let data = omci.status(device, true);
			if (data == null)
				return native_error(request, 'status');
			return { status: decorate_status(device, data) };
		}
	},

	/* status for the unauthenticated session: the serial's digits are the secret part. */
	status_public: {
		args: { device: 0 },
		call: function(request) {
			let device = device_arg(request);
			let data = omci.status(device, true);
			if (data == null)
				return native_error(request, 'status');
			let status = decorate_status(device, data);
			if (status.serial != null) {
				status.serial = substr(status.serial, 0, 4) + '********';
				status.identity.serial = status.serial;
			}
			return { status };
		}
	},

	status_live: {
		args: { device: 0 },
		call: function(request) {
			let device = device_arg(request);
			let data = omci.status(device, true);
			if (data == null)
				return native_error(request, 'status');
			return { status: decorate_status(device, data, true) };
		}
	},

	agent_set: {
		args: {
			device: 0,
			enabled: 0,
			permissive: 0,
			fake_omci: 0,
			olt_profile: 0,
			olt_profile_force: 0
		},
		call: function(request) {
			let opts = {};
			for (let key in [ 'enabled', 'permissive', 'fake_omci',
					      'olt_profile', 'olt_profile_force' ])
				if (request.args[key] != null)
					opts[key] = request.args[key];
			if (length(opts) == 0) {
				request.reply({ error: 'no agent option supplied' }, UBUS_STATUS_INVALID_ARGUMENT);
				return null;
			}
			if (omci.agent_set(device_arg(request), opts) == null)
				return native_error(request, 'agent_set');
			return { success: true };
		}
	},

	config_list: {
		args: { device: 0 },
		call: function(request) {
			let list = omci.config_list(device_arg(request));
			if (list == null)
				return native_error(request, 'config_list');
			for (let item in list)
				decorate_config_item(item);
			return { config: config_array_to_object(list), details: list };
		}
	},

	config_details: {
		args: { device: 0 },
		call: function(request) {
			let list = omci.config_list(device_arg(request));
			if (list == null)
				return native_error(request, 'config_details');
			for (let item in list)
				decorate_config_item(item);
			return { config: config_array_to_object(list), details: list };
		}
	},

	config_get: {
		args: { device: 0, key: '' },
		call: function(request) {
			let spec = find_spec_by_name(request.args.key);
			if (!spec) {
				request.reply({ error: 'unknown OMCI configuration key' }, UBUS_STATUS_INVALID_ARGUMENT);
				return null;
			}
			let item = omci.config_get(device_arg(request), spec.key);
			if (item == null)
				return native_error(request, 'config_get');
			return { config: decorate_config_item(item) };
		}
	},

	config_inspect: {
		args: { device: 0, key: '' },
		call: function(request) {
			let spec = find_spec_by_name(request.args.key);
			if (!spec) {
				request.reply({ error: 'unknown OMCI configuration key' }, UBUS_STATUS_INVALID_ARGUMENT);
				return null;
			}
			let item = omci.config_get(device_arg(request), spec.key);
			if (item == null)
				return native_error(request, 'config_inspect');
			return { config: decorate_config_item(item) };
		}
	},

	config_set: {
		args: { device: 0, key: '', value: '' },
		call: function(request) {
			let spec = find_spec_by_name(request.args.key);
			if (!spec) {
				request.reply({ error: 'unknown OMCI configuration key' }, UBUS_STATUS_INVALID_ARGUMENT);
				return null;
			}
			let value = request.args.value;
			if (spec.name == 'olt-profile' || spec.name == 'olt-profile-force')
				value = profile_value(value);
			if (omci.config_set(device_arg(request), spec.key, value) == null)
				return native_error(request, 'config_set');
			return { success: true, key: spec.name };
		}
	},

	class_list: {
		args: { device: 0 },
		call: function(request) {
			let list = omci.class_list(device_arg(request));
			if (list == null)
				return native_error(request, 'class_list');
			for (let item in list)
				decorate_class(item);
			return { classes: list };
		}
	},

	class_get: {
		args: { device: 0, class_id: 0 },
		call: function(request) {
			let item = omci.class_get(device_arg(request), request.args.class_id);
			if (item == null)
				return native_error(request, 'class_get');
			return { class: decorate_class(item) };
		}
	},

	mib_list: {
		args: { device: 0 },
		call: function(request) {
			let list = omci.mib_list(device_arg(request));
			if (list == null)
				return native_error(request, 'mib_list');
			for (let item in list)
				decorate_mib(item);
			return { objects: list };
		}
	},

	mib_get: {
		args: { device: 0, class_id: 0, entity_id: 0 },
		call: function(request) {
			let item = omci.mib_get(device_arg(request), request.args.class_id, request.args.entity_id);
			if (item == null)
				return native_error(request, 'mib_get');
			return { object: decorate_mib(item) };
		}
	},

	mib_set: {
		args: { device: 0, class_id: 0, entity_id: 0, attr_mask: 0, data: '' },
		call: function(request) {
			if (omci.mib_set(device_arg(request), request.args.class_id,
					 request.args.entity_id, request.args.attr_mask,
					 request.args.data) == null)
				return native_error(request, 'mib_set');
			return { success: true };
		}
	},

	mib_delete: {
		args: { device: 0, class_id: 0, entity_id: 0 },
		call: function(request) {
			if (omci.mib_delete(device_arg(request), request.args.class_id,
					    request.args.entity_id) == null)
				return native_error(request, 'mib_delete');
			return { success: true };
		}
	},

	mib_reset: {
		args: { device: 0 },
		call: function(request) {
			if (omci.mib_reset(device_arg(request)) == null)
				return native_error(request, 'mib_reset');
			return { success: true };
		}
	},

	raw_tx: {
		args: { device: 0, pdu: '' },
		call: function(request) {
			if (omci.raw_tx(device_arg(request), request.args.pdu) == null)
				return native_error(request, 'raw_tx');
			return { success: true };
		}
	},

	apply: {
		args: { device: 0 },
		call: function(request) {
			return apply_uci_values(request, device_arg(request));
		}
	},

	profile_list: {
		call: function() {
			return { profiles: profiles };
		}
	},

	profile_apply: {
		args: { device: 0, profile: '', serial: '', password: '' },
		call: function(request) {
			let p = profile_by_id(request.args.profile);
			if (!p) {
				request.reply({ error: 'unknown OMCI profile' }, UBUS_STATUS_INVALID_ARGUMENT);
				return null;
			}
			let values = {};
			for (let spec in config_specs)
				if (p.values[spec.option] != null)
					values[spec.option] = p.values[spec.option];
			if (`${request.args.serial || ''}` != '')
				values.serial = request.args.serial;
			if (`${request.args.password || ''}` != '')
				values.password = request.args.password;

			for (let input in p.inputs) {
				if (!input.required)
					continue;
				if (`${values[input.name] || ''}` == '') {
					request.reply({ error: `missing profile input: ${input.name}` },
						      UBUS_STATUS_INVALID_ARGUMENT);
					return null;
				}
			}

			set_uci_options(values);
			uci.set('omci', 'main', 'profile', p.id);
			uci.commit('omci');
			let result = apply_uci_values(request, device_arg(request));
			if (result == null)
				return null;
			return { success: true, profile: p.id, apply: result };
		}
	}
};

/*
 * rpcd's UCI commit emits config.change through procd. The listener is the
 * immediate path used by LuCI/ubus commits. The native uloop poll also detects
 * direct `uci commit omci` writes, which do not emit a ubus event. Both paths
 * call the same in-process ucode -> C binding -> Generic Netlink function.
 */
const config_listener = event_bus?.listener('config.change', config_change);
/*
 * The laser is on unless omci.main.transmit is '0'. Checked on every poll:
 * the driver refuses it until the BOSA is programmed, and a one-shot write
 * at load left the ONU silent until reboot. With transmit '0' allow_tx is
 * left to the user.
 */
function sync_transmit(fresh) {
	if ((uci_main(fresh).transmit ?? '1') == '0')
		return;

	let path = `${PON_SYSFS}/allow_tx`;
	let current = readfile(path);
	if (current != null && trim(current) != '1')
		writefile(path, '1');
}

/*
 * The VLAN the LAN side sends untagged, for drivers that offload it
 * (sfu_untag_vlan): the switch pushes it upstream and pops it downstream.
 * 0 leaves every service tagged on the LAN.
 */
function sync_untag_vlan(fresh) {
	let path = `${PON_SYSFS}/sfu_untag_vlan`;
	let current = readfile(path);
	if (current == null)
		return;

	let vid = int(uci_main(fresh).untag_vlan ?? '0');
	if (vid == null || vid < 0 || vid > 4094)
		vid = 0;
	if (int(trim(current)) != vid)
		writefile(path, `${vid}`);
}

/*
 * A bridge port pon0.N means "the LAN sends VLAN N untagged". With a driver
 * that offloads that (sfu_untag_vlan), pon0.N would tag the switch's frames
 * a second time: bridge pon0 itself and keep the intent in untag_vlan. Runs
 * on every poll, so a bridge saved from LuCI is corrected within seconds.
 */
function migrate_pon_vlan_ports() {
	if (readfile(`${PON_SYSFS}/sfu_untag_vlan`) == null)
		return;

	let net = cursor(), vid = 0, changed = false;

	net.foreach('network', 'device', (section) => {
		let ports = section.ports, out = [], hit = false;

		if (type(ports) != 'array')
			return;
		for (let port in ports) {
			let m = match(port, /^pon0\.([0-9]+)$/);

			if (m) {
				hit = true;
				vid = vid || int(m[1]);
				port = 'pon0';
			}
			if (index(out, port) < 0)
				push(out, port);
		}
		if (hit) {
			net.set('network', section['.name'], 'ports', out);
			changed = true;
		}
	});
	if (!changed)
		return;

	net.commit('network');
	if (!int(uci_main(true).untag_vlan ?? '0') && vid >= 1 && vid <= 4094) {
		uci.set('omci', 'main', 'untag_vlan', `${vid}`);
		uci.commit('omci');
	}
	warn(`omci: replaced bridge port pon0.${vid} with pon0; the switch now adds VLAN ${vid}\n`);
	event_bus.call('network', 'reload', {});
}

/*
 * Manual LAN-side VLANs for drivers that offload them (sfu_vlan_map):
 * vlan_translate 'WAN:LAN' and vlan_stack 'S:C'. They win over what the
 * OLT's VLAN rules ask for.
 */
function vlan_map_entries(out, list, mode) {
	for (let entry in (type(list) == 'array' ? list : (list ? [ list ] : []))) {
		let m = match(trim(`${entry}`), /^([0-9]+):([0-9]+)$/);
		let wan = m ? int(m[1]) : 0, lan = m ? int(m[2]) : 0;

		if (wan >= 1 && wan <= 4094 && lan >= 1 && lan <= 4094)
			push(out, `${mode}${wan}:${lan}`);
	}
}

function sync_vlan_map(fresh) {
	let path = `${PON_SYSFS}/sfu_vlan_map`;
	let current = readfile(path);
	if (current == null)
		return;

	let main = uci_main(fresh), entries = [];

	vlan_map_entries(entries, main.vlan_translate, 't');
	vlan_map_entries(entries, main.vlan_stack, 's');
	let want = join(' ', entries);
	/* A zero-byte write never reaches the driver: a newline clears the map. */
	if (trim(current) != want)
		writefile(path, `${want}\n`);
}

/* In EPON mode epon-oamd owns the LAN VLAN rewrite (CTC Port VLAN). */
function pon_mode_epon() {
	return trim(readfile(`${XPON_SYSFS}/mode_current`) ?? '') == 'epon';
}

/* omci-vlanscan clears the LAN VLAN rewrite while it probes pon0. */
function vlanscan_running() {
	let pid = int(trim(readfile('/var/run/omci-vlanscan.pid') ?? ''));

	return pid > 0 && readfile(`/proc/${pid}/comm`) != null;
}

const config_poll = interval(CONFIG_POLL_MS, () => {
	let epon = pon_mode_epon();

	/* EPON: no OMCI; only the transmitter permission and the bridge check. */
	if (!epon)
		auto_apply('poll');
	sync_transmit(false);
	migrate_pon_vlan_ports();
	if (vlanscan_running() || epon)
		return;
	sync_untag_vlan(false);
	sync_vlan_map(false);
});

/*
 * omcid (START=11) owns the device once bound; until its socket is up the
 * kernel refuses configuration writes, so give it a few seconds first.
 */
function wait_for_omcid() {
	if (!access('/etc/rc.d/S11omcid'))
		return;
	for (let i = 0; i < 50 && !access('/var/run/omcid.sock'); i++)
		sleep(200);
}

/* Best-effort boot-time UCI application with no external execution. */
if (!pon_mode_epon()) {
	wait_for_omcid();
	auto_apply('startup');
}

/*
 * The xPON driver holds the first GPON activation until the identity above is
 * applied, so the OLT never sees the flash serial ranging first. Release it.
 */
let identity_wait = `${PON_SYSFS}/gpon_identity_wait`;
if (readfile(identity_wait) != null)
	writefile(identity_wait, '0');

sync_transmit(true);
migrate_pon_vlan_ports();
if (!pon_mode_epon()) {
	sync_untag_vlan(true);
	sync_vlan_map(true);
}

return { 'omci.agent': methods };
