#!/bin/sh
# DEBUG ONLY: the bench ISP's settings, so a RAM boot comes up as LuCI left
# it (Nokia ALCL, stock identity, LAN tagged VLAN 100 priority 0). Delete
# this file before a release image.
uci -q batch <<'EOF'
set omci.main.olt_profile='nokia-alcl'
set omci.main.olt_profile_force='nokia-alcl'
set omci.main.serial='ZYOT20095605'
set omci.main.vendor_id='ZYOT'
set omci.main.hardware_version='Hardware1.0'
set omci.main.software_version_0='AOT5222ZY_R1.3'
set omci.main.software_version_1='AOT5222ZY_R1.1'
set omci.main.equipment_id='AOT-5222ZY'
set omci.main.omcc_version='160'
set omci.main.traffic_management_option='0'
set omci.main.dba_status_reporting='1'
set omci.main.onu_type='2'
set omci.main.uni_count='4'
set omci.main.untag_vlan='100'
set omci.vlan=vlan
set omci.vlan.mode='tagged'
set omci.vlan.vid='100'
set omci.vlan.prio='0'
commit omci
EOF
exit 0
