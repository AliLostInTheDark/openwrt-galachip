From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] arm: zte: add the ZX279125 and the VSOL V2801SG

Add the ZX279125 platform and the VSOL V2801SG board: device tree,
board code, defconfig and configuration header. U-Boot manages the low
16 MiB of RAM and leaves the packet pool to the OS.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
diff --git a/arch/arm/Kconfig b/arch/arm/Kconfig
index 1b474a34..9d0d82e2 100644
--- a/arch/arm/Kconfig
+++ b/arch/arm/Kconfig
@@ -737,6 +737,20 @@ config TARGET_BCMNS
 	  ARMv7 Cortex-A9 SoC family including BCM4708, BCM47094,
 	  BCM5301x etc.
 
+config TARGET_ZX279125
+	bool "Support ZTE Sanechips ZX279125"
+	select CPU_V7A
+	select DM
+	select DM_SERIAL
+	select OF_CONTROL
+	select TIMER
+	select ZX279125_SERIAL
+	select ZX279125_TIMER
+	help
+	  Support for ZTE Sanechips ZX279125 ARMv7 Cortex-A9 SoC
+	  found on devices like the VSOL V2801SG GPON ONT.
+
+
 config TARGET_BCMNS3
 	bool "Support Broadcom NS3"
 	select ARM64
@@ -2434,6 +2448,7 @@ source "board/armltd/vexpress64/Kconfig"
 source "board/cortina/presidio-asic/Kconfig"
 source "board/broadcom/bcmns/Kconfig"
 source "board/broadcom/bcmns3/Kconfig"
+source "board/zte/zx279125/Kconfig"
 source "board/cavium/thunderx/Kconfig"
 source "board/eets/pdu001/Kconfig"
 source "board/emulation/qemu-arm/Kconfig"
diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 37d3b6fd..e69cb5d7 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -983,6 +983,8 @@ dtb-$(CONFIG_TARGET_BCMNS) += ns-board.dtb
 
 dtb-$(CONFIG_TARGET_BCMNS3) += ns3-board.dtb
 
+dtb-$(CONFIG_TARGET_ZX279125) += zx279125-vsol-v2801sg.dtb
+
 dtb-$(CONFIG_ARCH_BCMSTB) += bcm7xxx.dtb
 
 dtb-$(CONFIG_BCM47622) += \
diff --git a/arch/arm/dts/zx279125-vsol-v2801sg.dts b/arch/arm/dts/zx279125-vsol-v2801sg.dts
new file mode 100644
index 00000000..23b4974d
--- /dev/null
+++ b/arch/arm/dts/zx279125-vsol-v2801sg.dts
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Device Tree for VSOL V2801SG (ZTE Sanechips ZX279125)
+ *
+ * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
+ */
+
+/dts-v1/;
+
+/ {
+	model = "VSOL V2801SG";
+	compatible = "vsol,v2801sg", "zte,zx279125";
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	aliases {
+		serial0 = &uart0;
+		spi0 = &spifc;
+		ethernet0 = &ethernet;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a9";
+			reg = <0>;
+		};
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x01000000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		timer0: timer@94401000 {
+			compatible = "zte,zx279125-timer";
+			reg = <0x94401000 0x100>;
+			clock-frequency = <25000000>;
+			bootph-all;
+			u-boot,dm-pre-reloc;
+		};
+
+		uart0: serial@94405000 {
+			compatible = "zte,zx279125-uart";
+			reg = <0x94405000 0x100>;
+			clock-frequency = <25000000>;
+			current-speed = <115200>;
+			bootph-all;
+			u-boot,dm-pre-reloc;
+		};
+
+		spifc: spi@94407000 {
+			compatible = "zte,zx279125-spifc";
+			reg = <0x94407000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <25000000>;
+
+				partitions {
+					compatible = "fixed-partitions";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					partition@0 {
+						label = "u-boot";
+						reg = <0x000000 0x040000>;
+						read-only;
+					};
+
+					partition@40000 {
+						label = "firmware";
+						reg = <0x040000 0x740000>;
+					};
+
+					partition@780000 {
+						label = "others";
+						reg = <0x780000 0x010000>;
+					};
+
+					partition@790000 {
+						label = "tagparam";
+						reg = <0x790000 0x010000>;
+					};
+
+					partition@7a0000 {
+						label = "usercfg";
+						reg = <0x7a0000 0x060000>;
+					};
+				};
+			};
+		};
+
+		ethernet: ethernet@92144000 {
+			compatible = "zte,zx279125-eth";
+			reg = <0x92144000 0x1000>;
+			status = "okay";
+		};
+	};
+};
