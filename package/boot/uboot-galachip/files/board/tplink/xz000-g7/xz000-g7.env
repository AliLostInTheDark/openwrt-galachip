/* SPDX-License-Identifier: GPL-2.0-or-later */

ipaddr=192.168.1.1
serverip=192.168.1.10
loadaddr=0x41000000
bootfile=openwrt-galachip-gc1601-tplink_xz000-g7-initramfs-zImage
bootfile_upg=openwrt-galachip-gc1601-tplink_xz000-g7-squashfs-sysupgrade.bin
bootfile_uboot=openwrt-galachip-gc1601-tplink_xz000-g7-u-boot-with-spl.bin
bootfile_stock=g7-stock-firmware.bin
autoload=no
autostart=no

/* run stops at the first command that fails. */
bootcmd=run boot_flash
boot_flash=run load_flash boot_kernel
boot_tftp=run load_tftp find_dtb boot_kernel
backup_flash=run read_flash put_flash
upgrade_tftp=run load_upgrade check_tag check_size write_firmware
restore_stock=run load_stock check_tag check_stock write_firmware verify_firmware
upgrade_uboot=run load_uboot check_uboot write_uboot verify_uboot

load_flash=fwload ${loadaddr}
load_tftp=tftpboot ${loadaddr} ${bootfile}
find_dtb=zdtb ${loadaddr}
boot_kernel=bootz ${loadaddr} - ${fdt_addr}
read_flash=sf probe; sf read ${loadaddr} 0 0x400000
put_flash=tftpput ${loadaddr} 0x400000 xz000-g7-flash.bin

/* sysupgrade.bin starts with the firmware tag and must fit the partition. */
load_upgrade=tftpboot ${loadaddr} ${bootfile_upg}
check_tag=itest.l *${loadaddr} == 0x03000003
check_size=itest ${filesize} <= 0x3b0000
write_firmware=sf probe; sf update ${loadaddr} 0x20000 ${filesize}
verify_firmware=sf read 0x41400000 0x20000 ${filesize}; cmp.b ${loadaddr} 0x41400000 ${filesize}

/* The stock U-Boot's command line, used by fwload for stock kernels. */
bootargs_stock=console=ttyS0,115200n8 root=/dev/mtdblock3 mtdparts=a0000000.ftspi020:4096k@0x0(whole),128k@0x0(uboot),1472k@0x20000(kernel),2304k@0x190000(rootfs),128k@0x3d0000(misc),64k@0x3f0000(hwconfig) init=/sbin/init mem=32M bootv=V1.2.3(07/23/2023-17:14:04) rootwait user_debug=0xff

/* This unit's raw firmware partition backup: the whole 3776 KiB. */
load_stock=tftpboot ${loadaddr} ${bootfile_stock}
check_stock=itest ${filesize} == 0x3b0000

/*
 * The whole boot region (0x0-0x20000): SPL and proper, checked as the ROM
 * and the SPL check them. sf update only rewrites 4 KiB blocks that differ,
 * so an unchanged SPL is left alone; a broken one recovers over the ROM's
 * UART menu.
 */
load_uboot=tftpboot ${loadaddr} ${bootfile_uboot}
check_uboot=itest ${filesize} == 0x20000; ubcheck ${loadaddr} ${filesize}
write_uboot=sf probe; sf update ${loadaddr} 0 0x20000
verify_uboot=sf read 0x41200000 0 0x20000; cmp.b ${loadaddr} 0x41200000 0x20000
