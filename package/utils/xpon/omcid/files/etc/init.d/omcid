#!/bin/sh /etc/rc.common
# The GPON OMCI responder. The kernel has no OMCI engine of its own, so
# omcid has to own the device before the ONU ranges: rpcd (START=12)
# releases the identity wait and pon-mode (START=15) starts the MAC.

START=11
STOP=90
USE_PROCD=1

start_service() {
	local mode

	config_load xpon
	config_get mode main mode gpon
	[ "$mode" = epon ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/omcid
	# A restart reloads /tmp/omcid-0.state; give up after repeated failures.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xpon
}
